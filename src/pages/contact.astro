---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import {
  site,
  contact,
  enquiryMailto,
  discoveryCall,
  discoveryMailto,
  offerLadder,
} from '../config/site';

const review = offerLadder.groups[0].tiers[0];

const alternatives = [
  { label: 'Email directly', value: site.email, href: `mailto:${site.email}`, external: false },
  { label: 'LinkedIn', value: 'Connect on LinkedIn', href: site.linkedin, external: true },
  { label: 'GitHub', value: 'See the work behind the systems', href: site.github, external: true },
];

const prompts = [
  'What your business does',
  'The workflow that is causing problems',
  'The tools you currently use',
  'Roughly how often it happens',
  'How you found me',
];
---

<Layout
  title={`Contact · ${site.brand}`}
  description="Book a free discovery call, or request a Workflow Review from £350. One working session on a single workflow, with a short written recommendation."
>
  <div class="inner-v2 contact-page">
    <PageHeader label={contact.kicker} title={contact.title} subtitle={contact.intro} />

    <section class="inner-v2-section">
      <div class="home-v2-shell contact-page__layout">
        <div class="contact-page__action">
          <div class="contact-page__price">
            <span>Workflow Review</span>
            <strong>{contact.price}</strong>
          </div>

          <a class="contact-page__button" href={enquiryMailto}>
            Start a Workflow Review enquiry <span aria-hidden="true">↗</span>
          </a>

          <p class="contact-page__helper">{contact.helper}</p>

          <ul class="contact-page__prompts">
            {prompts.map((prompt) => <li>{prompt}</li>)}
          </ul>

          <p class="contact-page__fallback">
            The button opens your email client with the subject and prompts already filled in. If it does not,
            email <a href={`mailto:${site.email}`}>{site.email}</a> with the subject
            <strong>{contact.subject}</strong>.
          </p>
        </div>

        <aside class="contact-page__aside">
          <div class="contact-page__panel">
            <p class="home-v2-kicker">What a Review includes</p>
            <ul class="contact-page__list">
              {review.includes.map((item) => <li>{item}</li>)}
            </ul>
            <p class="contact-page__credit">{offerLadder.creditLine}</p>
            <a class="contact-page__link" href="/how-i-work">
              Compare Review and Audit <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="contact-page__panel contact-page__panel--quiet">
            <p class="home-v2-kicker">Other ways to reach me</p>
            <div class="contact-page__alts">
              {alternatives.map((link) => (
                <a
                  href={link.href}
                  {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <small>{link.label}</small>
                  <strong>{link.value}</strong>
                </a>
              ))}
            </div>
            <p class="contact-page__availability">
              <i aria-hidden="true"></i>{site.availability}
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section id="discovery" class="contact-fit">
      <div class="home-v2-shell contact-fit__inner">
        <div>
          <p class="home-v2-kicker">Free first step</p>
          <h2>{discoveryCall.title}</h2>
          <p>{discoveryCall.intro}</p>
          <ul>
            {discoveryCall.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="contact-fit__action">
          <a class="contact-page__button contact-page__button--secondary" href={discoveryMailto}>
            {discoveryCall.label} <span aria-hidden="true">↗</span>
          </a>
          <p>
            {discoveryCall.duration}. No obligation. If it looks worth doing, the next step is a Workflow Review
            ({contact.price}).
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .contact-page__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .contact-page__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ml-line);
  }

  .contact-page__price span {
    color: var(--ml-muted);
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-page__price strong {
    color: var(--ml-ink);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .contact-page__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.3rem;
    margin-top: 1.5rem;
    padding: 0.85rem 1.3rem;
    border-radius: 0.35rem;
    color: #fff;
    background: var(--ml-ink);
    border: 1px solid var(--ml-ink);
    font-size: 0.96rem;
    font-weight: 600;
    text-decoration: none;
  }

  .contact-page__button:hover {
    background: #1a1f26;
  }

  .contact-page__button--secondary {
    color: var(--ml-ink);
    background: var(--ml-paper-raised);
    border-color: var(--ml-line-strong);
  }

  .contact-page__button--secondary:hover {
    background: #fff;
  }

  .contact-page__helper,
  .contact-page__fallback,
  .contact-page__credit {
    margin: 1rem 0 0;
    color: var(--ml-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .contact-page__prompts {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .contact-page__prompts li {
    padding-left: 0.85rem;
    border-left: 2px solid var(--ml-system);
    color: var(--ml-ink-soft);
    font-size: 0.94rem;
  }

  .contact-page__fallback a,
  .contact-page__link {
    color: var(--ml-system);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .contact-page__aside {
    display: grid;
    gap: 1rem;
  }

  .contact-page__panel {
    padding: 1.35rem;
    border: 1px solid var(--ml-line);
    border-radius: 0.5rem;
    background: var(--ml-paper-raised);
  }

  .contact-page__panel--quiet {
    background: var(--ml-paper);
  }

  .contact-page__list {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .contact-page__list li {
    color: var(--ml-ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .contact-page__link {
    display: inline-flex;
    margin-top: 1rem;
    text-decoration: none;
  }

  .contact-page__link:hover {
    text-decoration: underline;
  }

  .contact-page__alts {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.85rem;
  }

  .contact-page__alts a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: inherit;
  }

  .contact-page__alts small {
    color: var(--ml-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-page__alts strong {
    color: var(--ml-ink);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .contact-page__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 1.1rem 0 0;
    color: var(--ml-ink-soft);
    font-size: 0.88rem;
  }

  .contact-page__availability i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ml-success, #1f6b4a);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ml-success, #1f6b4a) 16%, transparent);
  }

  .contact-fit {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    border-top: 1px solid var(--ml-line);
    background: var(--ml-paper-raised);
  }

  .contact-fit__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }

  .contact-fit h2 {
    margin: 0.75rem 0 0;
    max-width: 18ch;
    color: var(--ml-ink);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .contact-fit p {
    max-width: 36rem;
    margin: 0.85rem 0 0;
    color: var(--ml-ink-soft);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .contact-fit ul {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .contact-fit li {
    padding-left: 0.85rem;
    border-left: 2px solid var(--ml-system);
    color: var(--ml-ink-soft);
    font-size: 0.92rem;
  }

  .contact-fit__action .contact-page__button {
    margin-top: 0;
  }

  .contact-fit__action p {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--ml-muted);
  }

  @media (max-width: 980px) {
    .contact-page__layout,
    .contact-fit__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
