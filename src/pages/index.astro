---
import Layout from '../components/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';

const pillars = [
  {
    slug: 'connect',
    title: 'Connect',
    impact: 'Bring the moving parts together.',
    description:
      'Connect the tools, data and information your business already depends on so work can move without people constantly copying, searching and re-entering information.',
    items: ['Tool & API integrations', 'Shared business context', 'Structured information flows'],
  },
  {
    slug: 'coordinate',
    title: 'Coordinate',
    impact: 'Move work forward without the chasing.',
    description: 'Route requests, trigger actions, prepare work and use AI where judgement genuinely helps.',
    items: ['Workflow orchestration', 'AI-assisted decisions', 'Routing, follow-ups and exceptions'],
  },
  {
    slug: 'control',
    title: 'Control',
    impact: 'Keep people in charge where it matters.',
    description: 'Put approvals, review points, audit trails and clear exception handling around consequential actions.',
    items: ['Human approval', 'Audit trails & visibility', 'Exceptions & manual override'],
  },
];

const steps = [
  {
    number: '01',
    tone: 'understand',
    title: '01 — Understand',
    description:
      'Map one important workflow as it actually runs today: the people, tools, handoffs, repetitive work, delays and decisions.',
    service: 'No-cost workflow review',
    output: 'A clear recommendation on where to start or whether anything should be built at all.',
    outputLabel: 'Outcome',
  },
  {
    number: '02',
    tone: 'build',
    title: '02 — Build',
    description:
      'Design and build the first useful system around a clearly defined workflow, using the right mix of automation, AI, integrations and human controls.',
    service: 'Scoped implementation',
    output: 'One working system solving a real operational problem.',
    outputLabel: 'Outcome',
  },
  {
    number: '03',
    tone: 'extend',
    title: '03 — Extend',
    description:
      'Where it creates value, connect additional workflows, teams and tools into a broader operating system.',
    service: 'Connected operating layer',
    output: 'Multiple workflows working together instead of as isolated automations.',
    outputLabel: 'Outcome',
  },
  {
    number: '04',
    tone: 'improve',
    title: '04 — Improve',
    description:
      'Monitor performance, handle exceptions, adapt workflows and keep the system useful as your business and technology change.',
    service: 'Ongoing support & improvement',
    output: 'A system that stays reliable, useful and current.',
    outputLabel: 'Outcome',
  },
];

const systems = [
  {
    tone: 'ember',
    icon: 'inbox',
    title: 'Shared Inbox Routing & Approval',
    description:
      'Requests arriving by email are classified, matched with the right context and routed according to urgency and your business rules. Routine work keeps moving, while exceptions and sensitive actions are held for the right person to approve.',
    image: '/images/projects/opsdesk/opsdesk-dashboard-homepage.png',
    imageAlt: 'OpsDesk request queue with chargeable work awaiting approval',
    href: '/insights/shared-inbox-routing-and-approval',
    cta: 'See how it works',
  },
  {
    tone: 'mist',
    icon: 'sales',
    title: 'Sales opportunity intelligence',
    description:
      'New prospects are continuously researched, enriched and assessed against your ideal customer profile. The best opportunities flow into the CRM with useful context and tailored outreach ready for review.',
    image: '/images/projects/prospect-intelligence-system.png',
    imageAlt: 'Prospect intelligence workspace showing researched prospects, ICP fit and outreach ready for review',
    imageFit: 'contain',
    href: '/insights/sales-opportunity-intelligence',
    cta: 'See how it works',
  },
  {
    tone: 'rose',
    icon: 'marketing',
    title: 'Marketing content engine',
    description:
      'Calls, meetings and internal knowledge are continuously turned into content ideas and first drafts. Relevant material is organised, shaped for the right channels and moved towards publication, with your team reviewing what goes live.',
    image: '/images/projects/marketing-content-system.png',
    imageAlt: 'Marketing content workspace showing source material, draft content and publishing review',
    imageFit: 'contain',
    href: '/insights/marketing-content-engine',
    cta: 'See how it works',
  },
  {
    tone: 'violet',
    icon: 'invoice',
    title: 'Invoice processing automation',
    description:
      'Invoices that arrive by email are extracted, checked against your rules and prepared as a draft bill in Xero or the accounting software the business already uses. Payment stays held until finance approves them.',
    image: '/images/systems/invoiceflow-ap/control-centre.png',
    imageAlt:
      'InvoiceFlow AP invoice review workspace showing validation checks, approval routing, and a draft accounting preview.',
    imageFit: 'contain',
    href: '/insights/invoice-processing-automation',
    cta: 'See how it works',
  },
];

const faqs = [
  {
    question: 'What kinds of businesses do you work with?',
    answer: [
      'Layer works best with growing businesses where important work is spread across email, spreadsheets, documents and different software tools.',
      'The strongest fit is usually a business where repetitive admin, manual handoffs or disconnected information are starting to slow the team down.',
    ],
  },
  {
    question: 'Do we need to replace our existing software?',
    answer: [
      'Usually, no.',
      'Layer is designed to work around the tools your team already relies on. We connect the right systems, improve how information moves between them and only recommend replacing software where there is a clear reason to.',
    ],
  },
  {
    question: 'What do you automate, and what stays with our team?',
    answer: [
      'We automate the repetitive and predictable parts of a workflow first: moving information, checking rules, preparing work, routing requests and keeping systems updated.',
      'Where judgement, approval or accountability matters, the right person stays in control. The aim is not maximum automation. It is the right level of automation for the process.',
    ],
  },
  {
    question: 'How does a project begin?',
    answer: [
      'We normally start with a no-cost review of one important workflow.',
      'We map how it actually works today, identify where time and effort are being lost and decide whether there is a worthwhile opportunity to improve it. If there is, we recommend the right next step. If there isn’t, we’ll say so.',
    ],
  },
  {
    question: 'Can we start with just one workflow?',
    answer: [
      'Yes. That is usually the best way to start.',
      'We build one useful system around a clearly defined problem, prove it in practice and extend into other workflows only where it creates value. You do not need to commit to a large transformation upfront.',
    ],
  },
  {
    question: 'How do you handle security, access and sensitive actions?',
    answer: [
      'We design access around the minimum the system actually needs and keep important actions behind clear controls.',
      'Depending on the workflow, that can include restricted permissions, human approval, audit trails, exception handling and manual override. Security and control are considered as part of the system design, not added afterwards.',
    ],
  },
  {
    question: 'How long does a project take?',
    answer: [
      'It depends on the workflow, the systems involved and how much needs to be integrated.',
      'A clearly defined first implementation can often move much faster than a broader systems project. After the workflow review, we’ll be able to give you a realistic view of scope, complexity and timing before you commit to the build.',
    ],
  },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand,
  description: site.description,
  url: site.url,
  email: site.email,
  image: new URL('/images/og-default.jpg', site.url).href,
  serviceType: 'Applied AI systems consultancy',
  areaServed: 'Worldwide',
  founder: {
    '@type': 'Person',
    name: site.founder,
    url: `${site.url}/about`,
    sameAs: [site.github, site.linkedin],
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.join(' '),
    },
  })),
  url: `${site.url}/#faq`,
};
---

<Layout title={site.title} description={site.description} jsonLd={[serviceJsonLd, faqJsonLd]}>
  <div class="layer-home">
    <section class="layer-hero" aria-labelledby="hero-title">
      <div class="layer-hero__atmosphere" aria-hidden="true"></div>
      <div class="layer-shell layer-hero__inner">
        <div class="layer-hero__copy" data-reveal data-hero-reveal>
          <h1 id="hero-title">
            <span class="layer-hero__line">
              <span class="layer-wordmark-inline" aria-label="Layer.">layer<span aria-hidden="true">.</span></span>
              {' '}builds the systems
            </span>
            <span class="layer-hero__line">that connect your team</span>
            <span class="layer-hero__line">and your tools.</span>
          </h1>
          <p class="layer-hero__intro">
            We help growing businesses identify where AI can create real value, then design and build the systems,
            workflows and automations that put it to work.
          </p>
          <div class="layer-actions">
            <a class="layer-button layer-button--light" href="#contact">
              Book a no-cost workflow review <span aria-hidden="true">↗</span>
            </a>
            <a class="layer-link" href="#systems">Explore what Layer builds <span aria-hidden="true">↓</span></a>
          </div>
          <p class="layer-hero__note">No-cost workflow review · no obligation</p>
        </div>
      </div>
      <div class="layer-shell layer-hero__legend" aria-hidden="true">
        <span>Team</span><i></i><strong>Layer</strong><i></i><span>Tools</span>
      </div>
    </section>

    <section id="what-we-build" class="layer-section layer-builds" aria-labelledby="builds-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-section-head--model" data-reveal>
          <p class="layer-kicker">The operating model</p>
          <h2 id="builds-title">
            Connect the tools.<br />
            Coordinate the work.<br />
            Keep people in control.
          </h2>
          <p>Layer adds the operating layer between your team and the tools you already use.</p>
        </header>
        <div class="layer-triptych" data-reveal-stagger>
          {pillars.map((pillar) => (
            <article class={`layer-pillar layer-pillar--${pillar.slug}`} data-reveal>
              <div class="layer-pillar__copy">
                <h3>{pillar.title}</h3>
                <p class="layer-pillar__impact">{pillar.impact}</p>
                <p>{pillar.description}</p>
              </div>
              <div class="layer-pillar__examples">
                <p>Examples</p>
                <ul>
                  {pillar.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="systems" class="layer-section layer-systems" aria-labelledby="systems-title">
      <div class="layer-systems__scroller" data-systems-scroll>
        <div class="layer-systems__sticky">
          <div class="layer-shell">
            <header class="layer-section-head layer-systems__head" data-reveal>
              <div>
                <p class="layer-kicker">Example systems</p>
                <h2 id="systems-title">Systems Layer can build</h2>
              </div>
              <p>Every system is shaped around the teams, tools and software already inside the business.</p>
            </header>
            <div class="layer-system-viewport">
              <div class="layer-system-track" data-systems-track>
          {systems.map((system) => (
            <article class={`layer-system-card layer-system-card--${system.tone}`}>
              <div class="layer-system-card__copy">
                <span class="layer-system-card__icon" aria-hidden="true">
                  {system.icon === 'inbox' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M16 6.8v11.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                      <path d="M11.8 14.2 16 18.2 20.2 14.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M6.5 15.2h4.4l2 3.6h6.2l2-3.6h4.4V24.2H6.5V15.2Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                    </svg>
                  )}
                  {system.icon === 'sales' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <circle cx="16" cy="16" r="8.4" stroke="currentColor" stroke-width="1.45" />
                      <circle cx="16" cy="16" r="3.6" stroke="currentColor" stroke-width="1.45" />
                      <path d="M16 5.6v2.8M16 23.6v2.8M5.6 16h2.8M23.6 16h2.8" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                    </svg>
                  )}
                  {system.icon === 'marketing' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <rect x="8.5" y="6.8" width="15" height="18.4" rx="1.8" stroke="currentColor" stroke-width="1.45" />
                      <path d="M12.2 12.2h7.6M12.2 16h7.6M12.2 19.8h5" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                    </svg>
                  )}
                  {system.icon === 'invoice' && (
                    <svg viewBox="0 0 32 32" fill="none">
                      <path d="M9.2 6.8h10.2L22.8 10.2V25.2H9.2V6.8Z" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                      <path d="M19.4 6.8v3.6h3.4" stroke="currentColor" stroke-width="1.45" stroke-linejoin="round" />
                      <path d="M12.4 14.6h7.2M12.4 18.2h7.2M12.4 21.8h4.2" stroke="currentColor" stroke-width="1.45" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <h3>{system.title}</h3>
                <p>{system.description}</p>
                {system.href ? (
                  <a class="layer-system-card__link" href={system.href}>
                    {system.cta} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="layer-system-card__soon">Case study coming soon</span>
                )}
              </div>
              <div class="layer-system-card__stage">
                <div class="layer-system-card__wash" aria-hidden="true"></div>
                {system.image ? (
                  <div class="layer-system-card__media">
                    <figure
                      class:list={[
                        'layer-system-card__shot',
                        system.imageFit === 'contain' && 'layer-system-card__shot--contain',
                      ]}
                    >
                      {system.href ? (
                        <a href={system.href} aria-label={`${system.cta}: ${system.title}`}>
                          <img
                            src={system.image}
                            alt={system.imageAlt || ''}
                            width="1024"
                            height="792"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : (
                        <img
                          src={system.image}
                          alt={system.imageAlt || ''}
                          width="1024"
                          height="792"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </figure>
                  </div>
                ) : (
                  <div class="layer-system-card__placeholder">
                    <span>Screenshot coming soon</span>
                  </div>
                )}
              </div>
            </article>
          ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="how-we-work" class="layer-section layer-process" aria-labelledby="process-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-process__head" data-reveal>
          <div>
            <p class="layer-kicker">From friction to flow</p>
            <h2 id="process-title">
              Start with one workflow.<br />
              Build from there.
            </h2>
          </div>
          <p>
            We start by understanding one important process. If there’s a worthwhile opportunity, we build it, prove it
            in practice and extend only where it creates value.
          </p>
        </header>
        <ol class="layer-step-grid" data-reveal-stagger>
          {steps.map((step) => (
            <li class={`layer-step--named layer-step--${step.tone}`} data-reveal>
              <div class="layer-step__atmosphere" aria-hidden="true">
                <div class="layer-step__glow"></div>
              </div>
              <p class="layer-step__phase">{step.title}</p>
              <div class="layer-step__mark" aria-hidden="true">
                {step.tone === 'understand' && (
                  <svg viewBox="0 0 48 48" fill="none">
                    <path d="M13 8.5h15.5L35 15v24.5H13V8.5Z" stroke="currentColor" stroke-width="1.4" />
                    <path d="M28.5 8.5V15H35" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="23" cy="27" r="6.25" stroke="currentColor" stroke-width="1.4" />
                    <path d="M27.6 31.6 33.2 37.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                  </svg>
                )}
                {step.tone === 'build' && (
                  <svg viewBox="0 0 48 48" fill="none">
                    <rect x="8" y="22" width="16" height="16" rx="2.2" stroke="currentColor" stroke-width="1.4" />
                    <rect x="16" y="10" width="16" height="16" rx="2.2" stroke="currentColor" stroke-width="1.4" />
                    <rect x="24" y="22" width="16" height="16" rx="2.2" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
                {step.tone === 'extend' && (
                  <svg viewBox="0 0 48 48" fill="none">
                    <circle cx="12.5" cy="14" r="4.25" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="35.5" cy="14" r="4.25" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="24" cy="34.5" r="4.25" stroke="currentColor" stroke-width="1.4" />
                    <path
                      d="M16.4 15.6 21.2 31.2M31.6 15.6 26.8 31.2M16.8 14h14.4"
                      stroke="currentColor"
                      stroke-width="1.4"
                    />
                  </svg>
                )}
                {step.tone === 'improve' && (
                  <svg viewBox="0 0 48 48" fill="none">
                    <path
                      d="M34.5 18.2a11.5 11.5 0 1 0 1.8 9.4"
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                    />
                    <path d="M34.5 12.5v8.2h-8.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    <circle cx="24" cy="24.5" r="3.1" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
              </div>
              <h3>{step.service}</h3>
              <p>{step.description}</p>
              <div class="layer-step__output">
                <span>{step.outputLabel || 'Result'}</span>
                <p>{step.output}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="layer-review" data-reveal>
          <div>
            <p class="layer-kicker">Your first step</p>
            <h3>Start with a no-cost workflow review</h3>
          </div>
          <div>
            <p>
              We look at one important process as it actually runs today, identify where time and effort are being lost,
              and decide whether there’s a worthwhile opportunity to improve it. If there is, we’ll recommend the right
              next step. If there isn’t, we’ll say so.
            </p>
            <a class="layer-button layer-button--primary" href="#contact">
              Book a no-cost workflow review <span aria-hidden="true">↗</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section id="faq" class="layer-section layer-faq" aria-labelledby="faq-title">
      <div class="layer-shell layer-faq__layout">
        <header class="layer-section-head" data-reveal>
          <p class="layer-kicker">Questions, answered</p>
          <h2 id="faq-title">Frequently asked questions</h2>
          <p>Clear answers about how Layer works, what we build and how a project begins.</p>
        </header>
        <div class="layer-faq__list" data-faq data-reveal>
          {faqs.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.question}</span>
                <i aria-hidden="true"></i>
              </summary>
              <div class="layer-faq__answer">
                {item.answer.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="layer-contact" aria-labelledby="contact-title">
      <div class="layer-contact__atmosphere" aria-hidden="true"></div>
      <div class="layer-shell layer-contact__layout">
        <div class="layer-contact__copy" data-reveal>
          <p class="layer-kicker">Start a conversation</p>
          <h2 id="contact-title">Where is work getting stuck in your business?</h2>
          <p>
            Tell us about one process that isn’t working as well as it should. We’ll look at where time and effort are
            being lost and whether there’s a worthwhile way to improve it.
          </p>
          <p class="layer-contact__note">No-cost workflow review. No obligation.</p>
        </div>
        <div data-reveal>
          <ContactForm variant="home" />
        </div>
      </div>
    </section>
  </div>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      document.querySelectorAll<HTMLElement>('[data-hero-reveal]').forEach((item) => item.classList.add('is-visible'));
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -7% 0px' },
      );
      revealItems.forEach((item) => {
        if (!item.hasAttribute('data-hero-reveal')) revealObserver.observe(item);
      });
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((detail) => {
      detail.addEventListener('toggle', () => {
        if (!detail.open) return;
        document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((other) => {
          if (other !== detail) other.open = false;
        });
      });
    });

    const systemsScroller = document.querySelector<HTMLElement>('[data-systems-scroll]');
    const systemsTrack = document.querySelector<HTMLElement>('[data-systems-track]');
    const systemsSticky = systemsScroller?.querySelector<HTMLElement>('.layer-systems__sticky');
    const desktopSystems = window.matchMedia('(min-width: 821px)');

    if (systemsScroller && systemsTrack && systemsSticky) {
      const viewport = systemsTrack.parentElement as HTMLElement;
      let ticking = false;

      const canPin = () => !reducedMotion && desktopSystems.matches;

      const updateSystems = () => {
        ticking = false;
        if (!canPin()) return;
        const pin = parseFloat(getComputedStyle(systemsSticky).top) || 0;
        const rect = systemsScroller.getBoundingClientRect();
        const range = Math.max(1, systemsScroller.offsetHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, (pin - rect.top) / range));
        const maxX = Math.max(0, systemsTrack.scrollWidth - viewport.clientWidth);
        systemsTrack.style.transform = `translate3d(${-maxX * progress}px, 0, 0)`;
      };

      const layoutSystems = () => {
        viewport.style.setProperty('--systems-w', `${viewport.clientWidth}px`);
        if (!canPin()) {
          systemsScroller.style.height = '';
          systemsTrack.style.transform = '';
          return;
        }
        const maxX = Math.max(0, systemsTrack.scrollWidth - viewport.clientWidth);
        systemsScroller.style.height = `${window.innerHeight + maxX * 1.15}px`;
        updateSystems();
      };

      const onSystemsScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateSystems);
      };

      layoutSystems();
      requestAnimationFrame(layoutSystems);
      window.addEventListener('scroll', onSystemsScroll, { passive: true });
      window.addEventListener('resize', layoutSystems);
      window.addEventListener('load', layoutSystems);
      desktopSystems.addEventListener('change', layoutSystems);
      if ('ResizeObserver' in window) {
        new ResizeObserver(layoutSystems).observe(viewport);
      }
    }
  </script>
</Layout>

<style>
  .layer-home {
    --layer-paper: #f6f4ef;
    --layer-paper-soft: #eceae5;
    --layer-ink: #111317;
    --layer-muted: #555d69;
    --layer-navy: #1d3557;
    --layer-navy-deep: #10233e;
    --layer-line: rgba(17, 19, 23, 0.13);
    color: var(--layer-ink);
    background: var(--layer-paper);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .layer-home *,
  .layer-home *::before,
  .layer-home *::after {
    box-sizing: border-box;
  }

  .layer-home a {
    text-decoration: none;
  }

  .layer-shell {
    width: min(88rem, calc(100% - 4rem));
    margin-inline: auto;
  }

  .layer-section {
    padding-block: clamp(6rem, 10vw, 10rem);
    scroll-margin-top: 4.75rem;
  }

  .layer-kicker {
    margin: 0;
    color: var(--layer-navy);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .layer-section-head {
    max-width: 47rem;
  }

  .layer-section-head h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(2.7rem, 5.6vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .layer-section-head > p:last-child {
    max-width: 38rem;
    margin: 1.4rem 0 0;
    color: var(--layer-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .layer-button {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 1.35rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid transparent;
    border-radius: 0.2rem;
    font-size: 0.86rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 220ms ease, background 220ms ease, box-shadow 220ms ease;
  }

  .layer-button:hover {
    transform: translateY(-2px);
  }

  .layer-button--primary {
    color: #fff;
    background: var(--layer-navy);
    box-shadow: 0 12px 30px rgba(29, 53, 87, 0.2);
  }

  .layer-button--primary:hover {
    color: #fff;
    background: var(--layer-navy-deep);
    box-shadow: 0 16px 34px rgba(29, 53, 87, 0.26);
  }

  .layer-button--light {
    color: var(--layer-navy-deep);
    background: #f8f6f1;
  }

  .layer-hero {
    --hero-period: #6eb4e8;
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    margin-top: -4.75rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: #f4f5f7;
    background: #101b2b;
  }

  .layer-hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 60% at 0% 0%, rgba(72, 178, 186, 0.58), transparent 62%),
      radial-gradient(ellipse 74% 66% at 100% 100%, rgba(224, 122, 48, 0.7), transparent 60%),
      #101b2b;
  }

  .layer-hero__atmosphere::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 52% 46% at 6% 4%, rgba(90, 196, 198, 0.36), transparent 70%),
      radial-gradient(ellipse 56% 50% at 94% 96%, rgba(240, 148, 68, 0.4), transparent 68%);
    filter: blur(48px);
  }

  .layer-hero__atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.9'/%3E%3C/svg%3E");
  }

  .layer-shell.layer-hero__inner {
    position: relative;
    z-index: 2;
    width: min(92rem, calc(100% - 3rem));
    padding-block: clamp(6.5rem, 12vh, 9rem) clamp(6.5rem, 11vh, 9rem);
    text-align: center;
  }

  .layer-hero__copy {
    width: 100%;
    margin-inline: auto;
  }

  .layer-hero h1 {
    margin: 0 auto;
    color: #fff;
    font-size: clamp(1.45rem, 4.6vw, 4.85rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .layer-hero__line {
    display: block;
    white-space: nowrap;
  }

  .layer-hero h1 .layer-wordmark-inline {
    color: inherit;
    font-weight: 450;
    letter-spacing: -0.065em;
    white-space: nowrap;
  }

  .layer-hero h1 .layer-wordmark-inline span {
    color: var(--hero-period);
  }

  .layer-hero__intro {
    max-width: 38rem;
    margin: 2rem auto 0;
    color: rgba(244, 245, 247, 0.72);
    font-size: clamp(1.0625rem, 1.55vw, 1.28rem);
    font-weight: 300;
    line-height: 1.6;
  }

  .layer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.4rem;
    margin-top: 1.45rem;
  }

  .layer-hero .layer-actions {
    justify-content: center;
  }

  .layer-link {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    color: var(--layer-ink);
    border-bottom: 1px solid rgba(17, 19, 23, 0.35);
    padding: 0.75rem 0;
    font-size: 0.86rem;
  }

  .layer-link:hover {
    color: var(--layer-navy);
    border-color: var(--layer-navy);
  }

  .layer-hero .layer-button--light {
    color: #10233e;
    background: #f8f6f1;
    box-shadow: none;
  }

  .layer-hero .layer-button--light:hover {
    background: #fff;
  }

  .layer-hero .layer-link {
    color: rgba(244, 245, 247, 0.88);
    border-bottom-color: rgba(244, 245, 247, 0.38);
  }

  .layer-hero .layer-link:hover {
    color: #fff;
    border-bottom-color: #fff;
  }

  .layer-hero__note {
    margin: 0.9rem auto 0;
    color: rgba(244, 245, 247, 0.45);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .layer-hero__legend {
    position: absolute;
    z-index: 3;
    bottom: 1.3rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(244, 245, 247, 0.42);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .layer-hero__legend i {
    width: 1.4rem;
    height: 1px;
    background: rgba(244, 245, 247, 0.28);
  }

  .layer-hero__legend strong {
    color: #fff;
    font-weight: 500;
  }

  .layer-builds {
    position: relative;
    overflow: hidden;
    color: var(--layer-ink);
    background: #efede8;
  }

  .layer-contact::after,
  .layer-systems__sticky::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.08;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }

  .layer-systems .layer-shell,
  .layer-contact .layer-shell {
    position: relative;
    z-index: 1;
  }

  .layer-section-head--light .layer-kicker {
    color: #c7d4e4;
  }

  .layer-section-head--light > p:last-child {
    color: rgba(244, 245, 247, 0.68);
  }

  .layer-section-head--model {
    max-width: 52rem;
  }

  .layer-section-head--model .layer-kicker {
    color: var(--layer-navy);
  }

  .layer-section-head--model h2 {
    color: var(--layer-ink);
    font-size: clamp(2.15rem, 4.4vw, 4.1rem);
    line-height: 1.06;
    text-wrap: pretty;
  }

  .layer-section-head--model > p:last-child {
    color: var(--layer-muted);
  }

  .layer-triptych {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .layer-pillar {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.75rem;
    padding: clamp(1.25rem, 2.2vw, 1.75rem);
    background: #27384a;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.18);
    transition: transform 300ms ease;
  }

  .layer-pillar::before {
    content: '';
    position: absolute;
    inset: -20%;
    z-index: -1;
    filter: blur(34px);
    transform: scale(1.05);
    transition: transform 700ms ease;
  }

  .layer-pillar:hover {
    transform: translateY(-4px);
  }

  .layer-pillar:hover::before {
    transform: scale(1.12) translate3d(1%, -1%, 0);
  }

  .layer-pillar--connect::before {
    background:
      radial-gradient(circle at 24% 18%, rgba(230, 160, 122, 0.94), transparent 36%),
      radial-gradient(circle at 83% 65%, rgba(97, 143, 149, 0.8), transparent 45%),
      #263b52;
  }

  .layer-pillar--coordinate::before {
    background:
      radial-gradient(circle at 72% 25%, rgba(223, 171, 140, 0.85), transparent 38%),
      radial-gradient(circle at 20% 82%, rgba(75, 91, 137, 0.86), transparent 42%),
      #564452;
  }

  .layer-pillar--control::before {
    background:
      radial-gradient(circle at 38% 28%, rgba(152, 187, 180, 0.88), transparent 40%),
      radial-gradient(circle at 76% 84%, rgba(197, 110, 92, 0.7), transparent 42%),
      #24384a;
  }

  .layer-pillar__copy {
    margin: 0;
    padding: 0;
  }

  .layer-pillar h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 3.2vw, 2.85rem);
    font-weight: 500;
    letter-spacing: -0.055em;
  }

  .layer-pillar__impact {
    margin: 0.85rem 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .layer-pillar__copy > p:last-child {
    margin: 0.7rem 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .layer-pillar__examples {
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .layer-pillar__examples > p {
    margin: 0 0 0.55rem;
    color: rgba(255, 255, 255, 0.42);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .layer-pillar ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .layer-pillar li {
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .layer-process {
    background: #efede8;
  }

  .layer-process__head,
  .layer-systems__head {
    max-width: none;
    display: grid;
    grid-template-columns: 1fr minmax(20rem, 0.55fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: end;
  }

  .layer-process__head > p,
  .layer-systems__head > p {
    margin: 0;
    color: var(--layer-muted);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .layer-step-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(3rem, 6vw, 5.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .layer-step-grid li {
    position: relative;
    isolation: isolate;
    overflow: visible;
    display: flex;
    flex-direction: column;
    min-height: 28rem;
    padding: 1.5rem;
    border: 1px solid rgba(29, 53, 87, 0.13);
    border-radius: 0.55rem;
    background: rgba(250, 249, 246, 0.72);
    box-shadow: 0 18px 48px rgba(40, 48, 61, 0.07);
  }

  .layer-step__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .layer-step__glow {
    position: absolute;
    z-index: -1;
    inset: -30%;
    opacity: 0.42;
    filter: blur(25px);
    transition: transform 800ms ease, opacity 500ms ease;
  }

  .layer-step--understand .layer-step__glow {
    background:
      radial-gradient(circle at 22% 18%, rgba(110, 160, 196, 0.22), transparent 32%),
      radial-gradient(circle at 78% 82%, rgba(70, 112, 128, 0.12), transparent 36%);
  }

  .layer-step--build .layer-step__glow {
    background:
      radial-gradient(circle at 24% 16%, rgba(218, 135, 106, 0.24), transparent 32%),
      radial-gradient(circle at 80% 84%, rgba(163, 96, 77, 0.1), transparent 36%);
  }

  .layer-step--extend .layer-step__glow {
    background:
      radial-gradient(circle at 20% 20%, rgba(107, 152, 155, 0.22), transparent 32%),
      radial-gradient(circle at 76% 80%, rgba(70, 112, 128, 0.12), transparent 36%);
  }

  .layer-step--improve .layer-step__glow {
    background:
      radial-gradient(circle at 26% 18%, rgba(137, 122, 168, 0.2), transparent 32%),
      radial-gradient(circle at 78% 82%, rgba(160, 99, 99, 0.1), transparent 36%);
  }

  .layer-step-grid li:hover .layer-step__glow {
    opacity: 0.7;
    transform: translate3d(4%, -3%, 0) scale(1.08);
  }

  @media (min-width: 1081px) {
    .layer-step-grid li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -0.5rem;
      z-index: 2;
      width: 0.34rem;
      height: 0.34rem;
      border-block-start: 1px solid rgba(29, 53, 87, 0.28);
      border-inline-end: 1px solid rgba(29, 53, 87, 0.28);
      transform: translate(50%, -50%) rotate(45deg);
      pointer-events: none;
    }
  }

  .layer-step__mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin: 1.15rem 0 0.15rem;
    color: var(--layer-navy);
  }

  .layer-step__mark::before {
    content: '';
    position: absolute;
    inset: -0.55rem;
    z-index: -1;
    border-radius: 999px;
    filter: blur(10px);
    opacity: 0.5;
  }

  .layer-step--understand .layer-step__mark::before {
    background: rgba(110, 160, 196, 0.2);
  }

  .layer-step--build .layer-step__mark::before {
    background: rgba(218, 135, 106, 0.22);
  }

  .layer-step--extend .layer-step__mark::before {
    background: rgba(107, 152, 155, 0.22);
  }

  .layer-step--improve .layer-step__mark::before {
    background: rgba(137, 122, 168, 0.2);
  }

  .layer-step__mark svg {
    width: 2.05rem;
    height: 2.05rem;
    display: block;
  }

  .layer-step__top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .layer-step__top > span:first-child {
    color: var(--layer-navy);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
  }

  .layer-step__phase {
    margin: clamp(4rem, 7vw, 6.5rem) 0 0;
    color: var(--layer-navy);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .layer-step-grid h3 {
    margin: 0.65rem 0 0;
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .layer-step-grid p {
    margin: 1rem 0 0;
    color: var(--layer-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .layer-step-grid .layer-step__phase {
    margin-top: clamp(4rem, 7vw, 6.5rem);
  }

  .layer-step-grid li.layer-step--named .layer-step__phase {
    margin-top: 0;
  }

  .layer-step--understand .layer-step__phase::after,
  .layer-step--build .layer-step__phase::after,
  .layer-step--extend .layer-step__phase::after {
    content: ' →';
    font-weight: 400;
    letter-spacing: 0;
    color: rgba(29, 53, 87, 0.38);
  }

  .layer-step__output {
    margin-top: auto;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(29, 53, 87, 0.14);
  }

  .layer-step__output > span {
    color: var(--layer-navy);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .layer-step-grid .layer-step__output p {
    margin-top: 0.45rem;
    color: #3f4854;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .layer-review {
    display: grid;
    grid-template-columns: 1fr minmax(22rem, 0.8fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
    margin-top: 1rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    color: #f4f5f7;
    background:
      radial-gradient(circle at 4% 5%, rgba(191, 117, 90, 0.45), transparent 35%),
      linear-gradient(135deg, #172b47, #1d3557 58%, #354e62);
    box-shadow: 0 28px 70px rgba(29, 53, 87, 0.18);
  }

  .layer-review .layer-kicker {
    color: #e0a07a;
  }

  .layer-review h3 {
    max-width: 12ch;
    margin: 1rem 0 0;
    font-size: clamp(2.3rem, 4.6vw, 4.8rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .layer-review > div:last-child > p {
    margin: 0 0 1.7rem;
    color: rgba(255, 255, 255, 0.72);
    font-weight: 300;
    line-height: 1.7;
  }

  .layer-review .layer-button--primary {
    color: var(--layer-navy-deep);
    background: #f5f3ee;
    box-shadow: none;
  }

  .layer-systems {
    position: relative;
    color: #f4f5f7;
    background: #101b2b;
  }

  .layer-systems.layer-section {
    padding-block: 0;
  }

  .layer-systems__scroller {
    position: relative;
    z-index: 1;
  }

  .layer-systems__sticky {
    position: sticky;
    top: 4.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: calc(100svh - 4.75rem);
    min-height: calc(100svh - 4.75rem);
    padding-block: 2.25rem 2.5rem;
    box-sizing: border-box;
    background:
      radial-gradient(ellipse 45% 60% at 6% 7%, rgba(163, 96, 77, 0.45), transparent 64%),
      radial-gradient(ellipse 55% 72% at 94% 100%, rgba(78, 116, 121, 0.4), transparent 64%),
      #101b2b;
  }

  .layer-systems__sticky .layer-shell {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: min(88rem, calc(100% - 4rem));
  }

  .layer-systems__head {
    flex-shrink: 0;
  }

  .layer-systems .layer-kicker {
    color: #e0a07a;
  }

  .layer-systems .layer-systems__head > p {
    color: rgba(244, 245, 247, 0.68);
  }

  .layer-systems .layer-systems__head h2 {
    color: #fff;
  }

  .layer-system-viewport {
    container-type: inline-size;
    flex: 1;
    min-height: 0;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
  }

  .layer-system-track {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    height: 100%;
    min-height: 0;
    will-change: transform;
  }

  .layer-system-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 calc((var(--systems-w, 100cqi) - 1rem) / 2);
    width: calc((var(--systems-w, 100cqi) - 1rem) / 2);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 1.35rem;
    background: rgba(248, 246, 241, 0.88);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.62),
      0 18px 40px rgba(8, 16, 28, 0.12);
    backdrop-filter: blur(14px) saturate(108%);
    transition: transform 300ms ease, border-color 300ms ease, box-shadow 300ms ease;
  }

  .layer-system-card:hover {
    border-color: rgba(255, 255, 255, 0.32);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.42),
      0 24px 48px rgba(8, 16, 28, 0.2);
  }

  .layer-system-card__copy {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.7rem;
    align-items: start;
    padding: 1.65rem 1.55rem 1.15rem;
    background: transparent;
  }

  .layer-system-card__icon {
    display: grid;
    place-items: center;
    width: 2.55rem;
    height: 2.55rem;
    border: 1px solid rgba(29, 53, 87, 0.12);
    border-radius: 0.55rem;
    color: var(--layer-navy);
    background: rgba(29, 53, 87, 0.05);
  }

  .layer-system-card__icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .layer-system-card h3,
  .layer-system-card__copy > p,
  .layer-system-card__link,
  .layer-system-card__soon {
    grid-column: 2;
  }

  .layer-system-card h3 {
    margin: 0.15rem 0 0;
    max-width: 28ch;
    color: var(--layer-ink);
    font-size: clamp(1.45rem, 2.1vw, 1.85rem);
