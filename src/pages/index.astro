---
import Layout from '../components/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';

const problems = [
  'Your team spends hours moving the same information between systems.',
  'Work gets stuck waiting for someone to notice, decide or follow up.',
  'Nobody has the full picture when a request changes hands.',
  'The process only works when the right person remembers every step.',
];

const pillars = [
  {
    slug: 'connect',
    title: 'Connect',
    impact: 'Bring the moving parts into one system.',
    description: 'Bring together the tools, data and information your business already relies on.',
    items: ['Tool and API integrations', 'Shared operational data', 'Structured information flows'],
  },
  {
    slug: 'coordinate',
    title: 'Coordinate',
    impact: 'Move work forward without the chasing.',
    description: 'Create workflows that route work, trigger actions and keep processes moving.',
    items: ['Workflow coordination', 'AI-assisted decisions', 'Approvals and follow-ups'],
  },
  {
    slug: 'control',
    title: 'Control',
    impact: 'Keep people in charge where it matters.',
    description: 'Build in oversight, review points and clear exception handling.',
    items: ['Human approval', 'Audit trails and alerts', 'Evaluation and manual override'],
  },
];

const steps = [
  {
    number: '01',
    title: 'Understand the workflow',
    description: 'Map one important process as it actually runs: tools, people, decisions and where work gets stuck.',
    service: 'No-cost workflow review',
    output: 'A clear recommendation: build, investigate further, or leave it.',
  },
  {
    number: '02',
    title: 'Build the first workflow',
    description: 'If the path is clear, design and build one important workflow so the team can test it in practice.',
    service: 'Scoped implementation',
    output: 'One useful workflow running with the right controls and integrations.',
  },
  {
    number: '03',
    title: 'Connect more of the work',
    description: 'Extend the first workflow into a connected system across more tools, processes and teams.',
    service: 'Connected operating layer',
    output: 'A dependable operating layer supporting multiple workflows.',
  },
  {
    number: '04',
    title: 'Keep it useful',
    description: 'Monitor performance, handle exceptions, improve workflows and support the team as the business changes.',
    service: 'Support and improvement',
    output: 'A system that stays useful, reliable and improving.',
  },
];

const systems = [
  {
    tone: 'ember',
    title: 'Request-to-resolution systems',
    description:
      'Capture incoming requests, extract the relevant information, assign responsibility, manage approvals and track progress through to completion.',
    exampleLabel: 'Example system',
    image: '/images/projects/opsdesk/opsdesk-dashboard-homepage.png',
    imageAlt: 'OpsDesk request queue with chargeable work awaiting approval',
    href: '/insights/opsdesk-shared-inbox-control',
    cta: 'See how it works',
    integrations: [
      { label: 'Intake', name: 'Gmail', icon: '/images/integrations/gmail.png' },
      { label: 'Alerts', name: 'Slack', icon: '/images/integrations/slack.png' },
      { label: 'Context', name: 'HubSpot', icon: '/images/integrations/hubspot.png' },
    ],
  },
  {
    tone: 'violet',
    title: 'Invoice and document processing',
    description:
      'Process supplier invoices from email and documents. Extract the relevant information, apply approval rules, and route exceptions for finance review.',
    exampleLabel: 'Example system',
    image: '/images/systems/invoiceflow-ap/control-centre.png',
    imageAlt:
      'InvoiceFlow AP invoice review workspace showing validation checks, approval routing, and a draft accounting preview.',
    imageFit: 'contain',
    href: '/insights/invoice-and-document-processing',
    cta: 'See how it works',
    integrations: [
      { label: 'Intake', name: 'Email', icon: '/images/integrations/email.png' },
      { label: 'Policy', name: 'InvoiceFlow AP', icon: '/images/integrations/invoiceflow-ap.svg' },
      { label: 'Accounting', name: 'Accounting platforms', icon: '/images/integrations/xero.png' },
    ],
  },
  {
    tone: 'mist',
    title: 'Marketing operations',
    description:
      'Move campaign and content work from brief to draft, approval and publishing without chasing across chats, documents and inboxes.',
    exampleLabel: 'Example system',
    image: '/images/systems/marketing-ops/control-centre.png',
    imageAlt: 'Marketing operations workspace showing campaign briefs, draft copy and approval status',
    imageFit: 'contain',
    href: '/insights/marketing-operations-workflow',
    cta: 'See how it works',
    integrations: [
      { label: 'Briefs', name: 'Email', icon: '/images/integrations/email.png' },
      { label: 'Context', name: 'HubSpot', icon: '/images/integrations/hubspot.png' },
      { label: 'Alerts', name: 'Slack', icon: '/images/integrations/slack.png' },
    ],
  },
  {
    tone: 'rose',
    title: 'Lead qualification and follow-up',
    description:
      'Capture enquiries, assess fit, draft responses and keep follow-up consistent, with a person still deciding what gets sent.',
    exampleLabel: 'Example system',
    image: '/images/systems/sales-ops/control-centre.png',
    imageAlt: 'Enquiry workspace showing incoming leads, fit assessment and a draft reply',
    imageFit: 'contain',
    href: '/insights/lead-qualification-and-follow-up',
    cta: 'See how it works',
    integrations: [
      { label: 'Intake', name: 'Gmail', icon: '/images/integrations/gmail.png' },
      { label: 'CRM', name: 'HubSpot', icon: '/images/integrations/hubspot.png' },
      { label: 'Alerts', name: 'Slack', icon: '/images/integrations/slack.png' },
    ],
  },
];

const faqs = [
  {
    question: 'What kinds of businesses do you work with?',
    answer: [
      'Layer works with growing businesses that have important workflows spread across multiple tools, teams and manual processes.',
      'The strongest fit is usually a business where repetitive operational work, disconnected information or unclear handovers are beginning to slow the team down.',
    ],
  },
  {
    question: 'Do we need to replace our existing software?',
    answer: [
      'No. Layer designs systems around the tools your business already uses.',
      'Where practical, we connect and improve your existing software rather than asking your team to replace everything or adopt an entirely new platform.',
    ],
  },
  {
    question: 'What can AI handle within a workflow?',
    answer: [
      'AI can help classify information, extract and structure data, draft responses, search internal knowledge, summarise activity and support operational decisions.',
      'The system can include human review, approval steps and escalation rules wherever judgement or oversight is required.',
    ],
  },
  {
    question: 'How does a project begin?',
    answer: [
      'Every project begins with a no-cost workflow review of one real process.',
      'If it is worth fixing and can be scoped, the next step is a first implementation. If more investigation is needed first, that is a technical discovery. If there is not a worthwhile problem, we will say so.',
    ],
  },
  {
    question: 'How long does a project take?',
    answer: [
      'Delivery time depends on the size and complexity of the workflow.',
      'Where possible, Layer begins with a focused first version that solves the most important part of the process. The system can then be tested, improved and expanded in stages.',
    ],
  },
];

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand,
  description: site.description,
  url: site.url,
  email: site.email,
  image: new URL('/images/og-default.jpg', site.url).href,
  serviceType: 'Applied AI systems consultancy',
  areaServed: 'Worldwide',
  founder: {
    '@type': 'Person',
    name: site.founder,
    url: `${site.url}/about`,
    sameAs: [site.github, site.linkedin],
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer.join(' '),
    },
  })),
  url: `${site.url}/#faq`,
};
---

<Layout title={site.title} description={site.description} jsonLd={[serviceJsonLd, faqJsonLd]}>
  <div class="layer-home">
    <section class="layer-hero" aria-labelledby="hero-title">
      <div class="layer-hero__atmosphere" aria-hidden="true">
        <picture>
          <source
            type="image/webp"
            srcset="/images/layer-hero-floating-network-800.webp 800w, /images/layer-hero-floating-network-1280.webp 1280w"
            sizes="100vw"
          />
          <img
            src="/images/layer-hero-floating-network-1280.jpg"
            alt=""
            width="1280"
            height="853"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <div class="layer-shell layer-hero__inner">
        <div class="layer-hero__copy" data-reveal data-hero-reveal>
          <p class="layer-eyebrow"><span></span> Applied AI for growing businesses</p>
          <h1 id="hero-title">
            <span class="layer-wordmark-inline" aria-label="Layer.">layer<span aria-hidden="true">.</span></span>
            {' '}builds<br />
            the systems<br />
            that connect<br />
            your team and<br />
            your tools.
          </h1>
          <p class="layer-hero__intro">
            We help growing businesses see where work is getting stuck between people and tools, then design and build
            the systems that move it forward.
          </p>
          <div class="layer-actions">
            <a class="layer-button layer-button--primary" href="#contact">
              Book a no-cost workflow review <span aria-hidden="true">↗</span>
            </a>
            <a class="layer-link" href="#what-we-build">Explore what Layer builds <span aria-hidden="true">↓</span></a>
          </div>
          <p class="layer-hero__note">No-cost workflow review · no obligation</p>
        </div>
      </div>
      <div class="layer-shell layer-hero__legend" aria-hidden="true">
        <span>Team</span><i></i><strong>Layer</strong><i></i><span>Tools</span>
      </div>
    </section>

    <section class="layer-section layer-problem" aria-labelledby="problem-title">
      <div class="layer-shell">
        <div class="layer-problem__grid">
          <header class="layer-section-head" data-reveal>
            <p class="layer-kicker">The operational gap</p>
            <h2 id="problem-title">Disconnected tools create manual work.</h2>
          </header>
          <div class="layer-problem__copy" data-reveal>
            <p>
              As businesses grow, work becomes spread across inboxes, spreadsheets, software and people. Teams spend
              more time copying information, chasing updates and managing handovers than moving the work forward.
            </p>
          </div>
        </div>
        <ol class="layer-problem__list" data-reveal-stagger>
          {problems.map((problem, index) => (
            <li data-reveal>
              <span>0{index + 1}</span>
              <p>{problem}</p>
              <i aria-hidden="true"></i>
            </li>
          ))}
        </ol>
        <p class="layer-problem__transition" data-reveal>
          <span class="layer-wordmark-inline" aria-label="Layer.">
            layer<span aria-hidden="true">.</span>
          </span>{' '}
          connects the work happening between your systems.
        </p>
      </div>
    </section>

    <section id="what-we-build" class="layer-section layer-builds" aria-labelledby="builds-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-section-head--light" data-reveal>
          <p class="layer-kicker">The operating model</p>
          <h2 id="builds-title">What Layer builds</h2>
          <p>Layer builds the systems that connect information, coordinate work and keep people in control.</p>
        </header>
        <div class="layer-triptych" data-reveal-stagger>
          {pillars.map((pillar) => (
            <article class={`layer-pillar layer-pillar--${pillar.slug}`} data-reveal>
              <div class="layer-pillar__copy">
                <h3>{pillar.title}</h3>
                <p class="layer-pillar__impact">{pillar.impact}</p>
                <p>{pillar.description}</p>
              </div>
              <ul>
                {pillar.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="systems" class="layer-section layer-systems" aria-labelledby="systems-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-systems__head" data-reveal>
          <div>
            <p class="layer-kicker">Example systems</p>
            <h2 id="systems-title">Systems Layer can build</h2>
          </div>
          <p>Every system is shaped around the workflow, team and tools already inside the business.</p>
        </header>
        <div class="layer-system-grid" data-reveal-stagger>
          {systems.map((system) => (
            <article class={`layer-system-card layer-system-card--${system.tone}`} data-reveal>
              <div class="layer-system-card__copy">
                <span class="layer-system-card__badge">{system.exampleLabel}</span>
                <h3>{system.title}</h3>
                <p>{system.description}</p>
                {system.href ? (
                  <a class="layer-system-card__link" href={system.href}>
                    {system.cta} <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="layer-system-card__soon">Case study coming soon</span>
                )}
              </div>
              <div class="layer-system-card__stage">
                <div class="layer-system-card__wash" aria-hidden="true"></div>
                {system.image ? (
                  <div class={`layer-system-card__media${system.integrations ? ' layer-system-card__media--showcase' : ''}`}>
                    <figure
                      class:list={[
                        'layer-system-card__shot',
                        system.imageFit === 'contain' && 'layer-system-card__shot--contain',
                      ]}
                    >
                      {system.href ? (
                        <a href={system.href} aria-label={`${system.cta}: ${system.title}`}>
                          <img
                            src={system.image}
                            alt={system.imageAlt || ''}
                            width="1024"
                            height="792"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : (
                        <img
                          src={system.image}
                          alt={system.imageAlt || ''}
                          width="1024"
                          height="792"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                    </figure>
                    {system.integrations && (
                      <ul class="layer-system-card__integrations" aria-label="Connected tools">
                        {system.integrations.map((tool) => (
                          <li>
                            <span>{tool.label}</span>
                            <img src={tool.icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
                            <strong>{tool.name}</strong>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                ) : (
                  <div class="layer-system-card__placeholder">
                    <span>Screenshot coming soon</span>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="how-we-work" class="layer-section layer-process" aria-labelledby="process-title">
      <div class="layer-shell">
        <header class="layer-section-head layer-process__head" data-reveal>
          <div>
            <p class="layer-kicker">From friction to flow</p>
            <h2 id="process-title">Let’s build what comes next</h2>
          </div>
          <p>From first workflow to operating system.</p>
        </header>
        <ol class="layer-step-grid" data-reveal-stagger>
          {steps.map((step) => (
            <li data-reveal>
              <div class="layer-step__glow" aria-hidden="true"></div>
              <div class="layer-step__top">
                <span>{step.number}</span>
              </div>
              <p class="layer-step__phase">{step.title}</p>
              <h3>{step.service}</h3>
              <p>{step.description}</p>
              <div class="layer-step__output">
                <span>Result</span>
                <p>{step.output}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="layer-review" data-reveal>
          <div>
            <p class="layer-kicker">Your first step</p>
            <h3>Start with a no-cost workflow review</h3>
          </div>
          <div>
            <p>
              A focused conversation about one process: how it actually runs, where time is being lost, and whether
              there is a worthwhile next step. If the path is clear, that is a scoped implementation. If more
              investigation is needed first, that is a technical discovery. If there is not a worthwhile problem,
              we will say so.
            </p>
            <a class="layer-button layer-button--primary" href="#contact">
              Book a no-cost workflow review <span aria-hidden="true">↗</span>
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section id="faq" class="layer-section layer-faq" aria-labelledby="faq-title">
      <div class="layer-shell layer-faq__layout">
        <header class="layer-section-head" data-reveal>
          <p class="layer-kicker">Questions, answered</p>
          <h2 id="faq-title">Frequently asked questions</h2>
          <p>Clear answers about how Layer works, what we build and how a project begins.</p>
        </header>
        <div class="layer-faq__list" data-faq data-reveal>
          {faqs.map((item, index) => (
            <details open={index === 0}>
              <summary>
                <span>{item.question}</span>
                <i aria-hidden="true"></i>
              </summary>
              <div class="layer-faq__answer">
                {item.answer.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="layer-contact" aria-labelledby="contact-title">
      <div class="layer-contact__atmosphere" aria-hidden="true"></div>
      <div class="layer-shell layer-contact__layout">
        <div class="layer-contact__copy" data-reveal>
          <p class="layer-kicker">Start a conversation</p>
          <h2 id="contact-title">Where is work getting stuck in your business?</h2>
          <p>
            Tell us about the process, the tools involved and where the manual work is happening. We’ll help you
            understand what a better system could look like.
          </p>
          <p class="layer-contact__note">No-cost workflow review. No obligation.</p>
        </div>
        <div data-reveal>
          <ContactForm variant="home" />
        </div>
      </div>
    </section>
  </div>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      document.querySelectorAll<HTMLElement>('[data-hero-reveal]').forEach((item) => item.classList.add('is-visible'));
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -7% 0px' },
      );
      revealItems.forEach((item) => {
        if (!item.hasAttribute('data-hero-reveal')) revealObserver.observe(item);
      });
    }

    document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((detail) => {
      detail.addEventListener('toggle', () => {
        if (!detail.open) return;
        document.querySelectorAll<HTMLDetailsElement>('[data-faq] details').forEach((other) => {
          if (other !== detail) other.open = false;
        });
      });
    });
  </script>
</Layout>

<style>
  .layer-home {
    --layer-paper: #f6f4ef;
    --layer-paper-soft: #eceae5;
    --layer-ink: #111317;
    --layer-muted: #555d69;
    --layer-navy: #1d3557;
    --layer-navy-deep: #10233e;
    --layer-line: rgba(17, 19, 23, 0.13);
    color: var(--layer-ink);
    background: var(--layer-paper);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .layer-home *,
  .layer-home *::before,
  .layer-home *::after {
    box-sizing: border-box;
  }

  .layer-home a {
    text-decoration: none;
  }

  .layer-shell {
    width: min(88rem, calc(100% - 4rem));
    margin-inline: auto;
  }

  .layer-section {
    padding-block: clamp(6rem, 10vw, 10rem);
    scroll-margin-top: 4.75rem;
  }

  .layer-kicker,
  .layer-eyebrow {
    margin: 0;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .layer-kicker {
    color: var(--layer-navy);
  }

  .layer-section-head {
    max-width: 47rem;
  }

  .layer-section-head h2 {
    margin: 0.9rem 0 0;
    font-size: clamp(2.7rem, 5.6vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -0.065em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .layer-section-head > p:last-child {
    max-width: 38rem;
    margin: 1.4rem 0 0;
    color: var(--layer-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    font-weight: 300;
    line-height: 1.7;
  }

  .layer-button {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 1.35rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid transparent;
    border-radius: 0.2rem;
    font-size: 0.86rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 220ms ease, background 220ms ease, box-shadow 220ms ease;
  }

  .layer-button:hover {
    transform: translateY(-2px);
  }

  .layer-button--primary {
    color: #fff;
    background: var(--layer-navy);
    box-shadow: 0 12px 30px rgba(29, 53, 87, 0.2);
  }

  .layer-button--primary:hover {
    color: #fff;
    background: var(--layer-navy-deep);
    box-shadow: 0 16px 34px rgba(29, 53, 87, 0.26);
  }

  .layer-button--light {
    color: var(--layer-navy-deep);
    background: #f8f6f1;
  }

  .layer-hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 4.75rem);
    overflow: hidden;
    display: flex;
    align-items: center;
    background: #d9d9d4;
  }

  .layer-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.12;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.9'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  .layer-hero__atmosphere {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    background: #e8e1d5;
  }

  .layer-hero__atmosphere picture,
  .layer-hero__atmosphere img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .layer-hero__atmosphere img {
    object-fit: cover;
    object-position: center;
  }

  .layer-hero__atmosphere::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(246, 244, 239, 0.22), transparent 45%);
  }

  .layer-hero__beam {
    position: absolute;
    left: 32%;
    top: 48%;
    width: 75%;
    height: 8rem;
    transform: translateY(-50%) rotate(-2deg);
    background: linear-gradient(90deg, rgba(255, 221, 179, 0), rgba(255, 231, 202, 0.82) 30%, rgba(232, 239, 217, 0.7) 70%, rgba(192, 222, 216, 0));
    filter: blur(22px);
  }

  .layer-hero__planes {
    position: absolute;
    right: -9vw;
    top: 50%;
    width: min(61vw, 60rem);
    height: 33rem;
    transform: translateY(-48%) rotate(-7deg) skewX(-16deg);
  }

  .layer-hero__plane {
    position: absolute;
    left: 10%;
    width: 84%;
    height: 28%;
    display: block;
    border-radius: 1.5rem 0.35rem 1.5rem 0.35rem;
    box-shadow: 0 24px 60px rgba(20, 32, 52, 0.2);
  }

  .layer-hero__plane--top {
    top: 3%;
