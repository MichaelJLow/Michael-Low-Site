---
import Layout from '../components/Layout.astro';
import OfferLadder from '../components/OfferLadder.astro';
import CtaBand from '../components/CtaBand.astro';
import {
  site,
  homeHero,
  homeOfferSection,
  homeProofSection,
  homeWhoLabel,
  homeWhoTitle,
  homeWhoIntro,
  homeWhoPains,
  processStrip,
  homeFounderLine,
  primaryCta,
  secondaryCta,
  contact,
} from '../config/site';
import { getHomeFeaturedProjects } from '../utils/content';

const systems = await getHomeFeaturedProjects();
const [flagship, ...supporting] = systems;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand,
  description: site.description,
  url: site.url,
  email: site.email,
  founder: {
    '@type': 'Person',
    name: site.name,
    url: `${site.url}/about`,
    sameAs: [site.github, site.linkedin],
  },
  areaServed: 'Worldwide',
  serviceType: 'Applied AI workflow design, automation and implementation',
};
---

<Layout title={site.title} description={site.description} jsonLd={jsonLd}>
  <div class="mock">
    <section class="mock-hero" aria-labelledby="mock-hero-title">
      <div class="mock-shell mock-hero__grid">
        <div class="mock-hero__copy" data-reveal data-reveal-hero>
          <p class="mock-kicker">{site.brand}</p>
          <h1 id="mock-hero-title">{homeHero.headline}</h1>
          <p class="mock-hero__intro">{homeHero.support}</p>
          <div class="mock-actions">
            <a class="mock-button mock-button--primary" href={primaryCta.href}>{primaryCta.label}</a>
            <a class="mock-text-link" href={secondaryCta.href}>
              {secondaryCta.label} <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="mock-hero__price">{primaryCta.price} · one workflow, one session, a written recommendation</p>
        </div>

        <figure class="mock-refinement" data-reveal data-reveal-hero data-reveal-hero-media>
          <img
            src="/images/neural-system-hero.png"
            alt=""
            width="1254"
            height="1254"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <!-- SELECTED CASE STUDIES: OpsDesk flagship + two supporting -->
    <section id="case-studies" class="mock-section mock-systems" aria-labelledby="systems-title">
      <div class="mock-shell">
        <header class="mock-systems__head" data-reveal>
          <p class="mock-kicker">{homeProofSection.kicker}</p>
          <h2 id="systems-title">{homeProofSection.title}</h2>
          <p class="mock-systems__lede">{homeProofSection.intro}</p>
        </header>

        {flagship && (
          <article class="mock-feature" data-reveal data-reveal-media>
            <a href={`/projects/${flagship.slug}`} aria-label={`Read the ${flagship.data.title} case study`}>
              <div class="mock-feature__visual">
                {(flagship.data.cardImage ?? flagship.data.coverImage) ? (
                  <img
                    src={flagship.data.cardImage ?? flagship.data.coverImage}
                    alt={`${flagship.data.title} interface`}
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${flagship.data.coverPosition === 'top' ? 'left top' : (flagship.data.coverPosition ?? 'left top')};`}
                  />
                ) : null}
              </div>
              <div class="mock-feature__copy">
                <div class="mock-feature__meta">
                  <span>{flagship.data.category}</span>
                  <span>{flagship.data.status}</span>
                </div>
                <h3>{flagship.data.title}</h3>
                <p>{flagship.data.description}</p>
                {flagship.data.systemLine && (
                  <p class="mock-feature__system-line">{flagship.data.systemLine}</p>
                )}
                <span class="mock-feature__view">
                  Case study <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          </article>
        )}

        <div class="mock-pair" data-reveal-stagger>
          {supporting.map((project) => {
            const { title, description, coverImage, cardImage, coverFit, coverPosition, category, status } =
              project.data;
            const thumb = cardImage ?? coverImage;
            return (
              <article class="mock-pair__item" data-reveal data-reveal-media>
                <a href={`/projects/${project.slug}`} aria-label={`Read the ${title} case study`}>
                  <div class={`mock-pair__visual${coverFit === 'contain' ? ' mock-pair__visual--contain' : ''}`}>
                    {thumb ? (
                      <img
                        src={thumb}
                        alt={`${title} interface`}
                        loading="lazy"
                        decoding="async"
                        style={`object-fit: ${coverFit ?? 'cover'}; object-position: ${coverPosition ?? 'center top'};`}
                      />
                    ) : (
                      <span>{title}</span>
                    )}
                  </div>
                  <div class="mock-pair__copy">
                    <div class="mock-pair__meta">
                      <span>{category}</span>
                      <span>{status}</span>
                    </div>
                    <h3>{title}</h3>
                    <p>{description}</p>
                    <span class="mock-pair__view">
                      Case study <span aria-hidden="true">↗</span>
                    </span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        <div class="mock-section-action" data-reveal>
          <a class="mock-text-link" href="/projects">All case studies <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- WORKING WITH ME: the offer ladder -->
    <section id="working-with-me" class="mock-section mock-offer" aria-labelledby="offer-title">
      <div class="mock-shell">
        <header class="mock-offer__head" data-reveal>
          <p class="mock-kicker">{homeOfferSection.kicker}</p>
          <h2 id="offer-title">{homeOfferSection.title}</h2>
          <p class="mock-offer__lede">{homeOfferSection.intro}</p>
        </header>

        <div data-reveal>
          <OfferLadder variant="compact" />
        </div>

        <div class="mock-section-action" data-reveal>
          <a class="mock-text-link" href="/how-i-work">
            Full detail on how I work <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- WHO THIS IS FOR -->
    <section id="who" class="mock-section mock-who" aria-labelledby="who-title">
      <div class="mock-shell mock-who__layout">
        <header data-reveal>
          <p class="mock-kicker">{homeWhoLabel}</p>
          <h2 id="who-title">{homeWhoTitle}</h2>
          <p class="mock-who__lede">{homeWhoIntro}</p>
        </header>
        <ul class="mock-who__list" data-reveal data-reveal-delay="1">
          {homeWhoPains.map((pain) => <li>{pain}</li>)}
        </ul>
      </div>
    </section>

    <!-- PROCESS STRIP -->
    <section id="process" class="mock-section mock-process" aria-labelledby="process-title">
      <div class="mock-shell">
        <header class="mock-process__head" data-reveal>
          <p class="mock-kicker">How the work runs</p>
          <h2 id="process-title">Observe, simplify, build, iterate.</h2>
        </header>
        <ol class="mock-process__steps" data-reveal-stagger>
          {processStrip.map((step, index) => (
            <li data-reveal>
              <span>0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))}
        </ol>
        <p class="mock-founder" data-reveal>
          {homeFounderLine.text}
          <a href={homeFounderLine.href}>
            {homeFounderLine.linkLabel} <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <CtaBand
      kicker="Start here"
      title="Tell me which workflow is costing you the most."
      body={contact.intro}
    />
  </div>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = Array.from(document.querySelectorAll('[data-reveal]'));

    const show = (el) => el.classList.add('is-in');

    if (reduceMotion || !('IntersectionObserver' in window)) {
      reveals.forEach(show);
    } else {
      document.querySelectorAll('[data-reveal-hero]').forEach((el) => {
        window.setTimeout(() => show(el), 80);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            show(entry.target);
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
      );

      reveals.forEach((el) => {
        if (el.hasAttribute('data-reveal-hero')) return;
        observer.observe(el);
      });
    }
  </script>
</Layout>

<style>
  .mock {
    --paper: #f4f0e8;
    --raised: #faf7f1;
    --deep: #e9e2d7;
    --ink: #1d1f1e;
    --soft: #454744;
    --muted: #77756f;
    --line: rgba(48, 47, 43, 0.14);
    --line-strong: rgba(48, 47, 43, 0.24);
    --signal: #3d5a4c;
    --grain: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    color: var(--ink);
    background: var(--paper);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .mock a {
    text-decoration: none;
  }

  .mock a:not(.mock-button) {
    color: inherit;
  }

  .mock-shell {
    width: min(92rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .mock-kicker {
    margin: 0;
    color: var(--muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Hero */
  .mock-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - 5.6rem);
    display: flex;
    flex-direction: column;
    background: var(--paper);
  }

  .mock-hero::before,
  .mock-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mock-hero::before {
    z-index: 0;
    background:
      radial-gradient(ellipse 38% 52% at 74% 40%, rgba(190, 128, 73, 0.22), transparent 68%),
      radial-gradient(ellipse 34% 46% at 15% 73%, rgba(50, 73, 77, 0.13), transparent 70%),
      radial-gradient(ellipse 29% 36% at 34% 24%, rgba(255, 255, 255, 0.72), transparent 68%),
      radial-gradient(ellipse 30% 42% at 91% 84%, rgba(118, 95, 72, 0.12), transparent 72%),
      linear-gradient(118deg, rgba(255, 255, 255, 0.4), transparent 46%);
  }

  .mock-hero::after {
    z-index: 2;
    opacity: 1;
    background-image:
      repeating-linear-gradient(7deg, rgba(75, 62, 48, 0.038) 0, rgba(75, 62, 48, 0.038) 1px, transparent 1px, transparent 4px),
      repeating-linear-gradient(97deg, rgba(255, 255, 255, 0.1) 0, rgba(255, 255, 255, 0.1) 1px, transparent 1px, transparent 9px);
    mix-blend-mode: multiply;
  }

  .mock-hero__grid {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    width: min(92rem, calc(100% - 3rem));
    max-width: 92rem;
    margin-inline: auto;
    padding-block: clamp(4rem, 7vh, 6rem) clamp(3rem, 5vh, 4rem);
  }

  .mock-hero__copy {
    position: relative;
    z-index: 3;
    max-width: min(46rem, 52%);
  }

  .mock-hero h1 {
    margin: 1.25rem 0 0;
    font-size: clamp(2.7rem, 3.8vw + 0.9rem, 4.8rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .mock-hero__intro {
    max-width: 40rem;
    margin: 1.7rem 0 0;
    color: #263b47;
    font-size: clamp(1.02rem, 1.4vw, 1.22rem);
    font-weight: 400;
    line-height: 1.65;
    text-wrap: balance;
  }

  .mock-hero__price {
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .mock-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.65rem;
    margin-top: 2.5rem;
  }

  .mock-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.65rem;
    padding: 0.95rem 1.45rem;
    border-radius: 0.35rem;
    font-size: 0.98rem;
    font-weight: 500;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 220ms ease;
  }

  .mock-button:hover {
    transform: translateY(-2px);
  }

  .mock-button:active {
    transform: translateY(1px) scale(0.985);
  }

  a.mock-button.mock-button--primary {
    color: var(--paper);
    background: var(--ink);
    box-shadow: 0 8px 22px rgba(31, 31, 28, 0.12);
  }

  .mock-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--soft);
    font-size: 0.98rem;
    font-weight: 500;
  }

  .mock-text-link span {
    transition: transform 180ms ease;
  }

  .mock-text-link:hover {
    color: var(--ink);
  }

  .mock-text-link:hover span {
    transform: translate(2px, -1px);
  }

  .mock-refinement {
    position: absolute;
    left: auto;
    right: -1.5%;
    top: 53%;
    width: min(50%, 44rem);
    height: auto;
    aspect-ratio: 1;
    transform: translateY(-50%);
    margin: 0;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }

  .mock-refinement img {
    position: static;
    width: 100%;
    max-width: 100%;
    height: 100%;
    display: block;
    margin: 0;
    object-fit: contain;
    object-position: center;
    mix-blend-mode: darken;
    opacity: 0.98;
    -webkit-mask-image: radial-gradient(circle, #000 68%, rgba(0, 0, 0, 0.72) 83%, transparent 100%);
    mask-image: radial-gradient(circle, #000 68%, rgba(0, 0, 0, 0.72) 83%, transparent 100%);
  }

  /* Shared section chrome */
  .mock-section {
    padding-block: clamp(5rem, 9vw, 8rem);
    border-top: 1px solid var(--line);
  }

  .mock-systems__head h2,
  .mock-offer__head h2,
  .mock-who__layout h2,
  .mock-process__head h2 {
    max-width: 18ch;
    margin: 0.75rem 0 0;
    font-size: clamp(2.1rem, 3.8vw, 3.8rem);
    font-weight: 400;
    line-height: 1.03;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .mock-systems__lede,
  .mock-offer__lede,
  .mock-who__lede {
    max-width: 36rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 1.02rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .mock-section-action {
    display: flex;
    justify-content: flex-end;
    margin-top: 2.25rem;
  }

  /* Case studies */
  .mock-systems {
    background: linear-gradient(180deg, #f7f4ee 0%, #f2eee6 100%);
  }

  .mock-systems__head {
    margin-bottom: clamp(3.25rem, 6.5vw, 5rem);
  }

  .mock-feature {
    margin-bottom: clamp(3.25rem, 6vw, 5rem);
  }

  .mock-feature > a {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.75fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .mock-feature__visual {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 0;
    background: #0a0a0a;
    border-radius: 0.4rem;
    box-shadow:
      inset 0 0 0 1px rgba(48, 47, 43, 0.08),
      0 0.8rem 2rem rgba(48, 47, 43, 0.055);
  }

  .mock-feature__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: left top;
    image-rendering: -webkit-optimize-contrast;
    filter: contrast(1.04);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1), filter 300ms ease;
  }

  .mock-feature:hover .mock-feature__visual img {
    transform: scale(1.03);
    filter: contrast(1.05);
  }

  .mock-feature__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-top: 0.2rem;
  }

  .mock-feature__meta,
  .mock-pair__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    color: var(--muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mock-feature__copy h3 {
    margin: 1.1rem 0 0;
    font-size: clamp(1.9rem, 3vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .mock-feature__copy > p:not(.mock-feature__system-line) {
    max-width: 28rem;
    margin: 1.1rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .mock-feature__copy > p.mock-feature__system-line {
    margin: 1rem 0 0;
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mock-feature__view,
  .mock-pair__view {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.6rem;
    font-size: 0.82rem;
    font-weight: 500;
  }

  .mock-feature__view span,
  .mock-pair__view span {
    transition: transform 180ms ease;
  }

  .mock-feature:hover .mock-feature__view span,
  .mock-pair__item:hover .mock-pair__view span {
    transform: translate(2px, -2px);
  }

  .mock-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  .mock-pair__item > a {
    display: grid;
    gap: 0.8rem;
  }

  .mock-pair__visual {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #0a0a0a;
    border-radius: 0.4rem;
    box-shadow:
      inset 0 0 0 1px rgba(48, 47, 43, 0.07),
      0 0.55rem 1.4rem rgba(48, 47, 43, 0.045);
  }

  .mock-pair__visual--contain {
    display: grid;
    place-items: center;
  }

  .mock-pair__visual img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .mock-pair__copy h3 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .mock-pair__copy > p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.55;
  }

  .mock-pair__view {
    margin-top: 0.5rem;
    font-size: 0.78rem;
  }

  /* Working with me */
  .mock-offer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 50% at 90% 8%, rgba(48, 47, 43, 0.04) 0%, transparent 65%),
      linear-gradient(165deg, #f3eee5 0%, #ebe5da 55%, #e5dfd3 100%);
  }

  .mock-offer::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.07;
    background-image: var(--grain);
    background-size: 140px 140px;
    mix-blend-mode: multiply;
  }

  .mock-offer > * {
    position: relative;
    z-index: 1;
  }

  .mock-offer__head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* Who this is for */
  .mock-who__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .mock-who__list {
    display: grid;
    gap: 0;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .mock-who__list li {
    padding-block: 1.05rem;
    border-bottom: 1px solid var(--line);
    color: var(--soft);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.55;
  }

  .mock-who__list li:first-child {
    padding-top: 0;
  }

  .mock-who__list li:last-child {
    border-bottom: none;
  }

  /* Process strip */
  .mock-process {
    position: relative;
    isolation: isolate;
    background:
      linear-gradient(180deg, rgba(255, 252, 247, 0.85) 0%, transparent 32%),
      var(--raised);
  }

  .mock-process::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.045;
    background-image: var(--grain);
    background-size: 160px 160px;
    mix-blend-mode: multiply;
  }

  .mock-process > * {
    position: relative;
    z-index: 1;
  }

  .mock-process__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .mock-process__steps li {
    padding-top: 1.15rem;
    border-top: 1px solid var(--line-strong);
  }

  .mock-process__steps span {
    color: var(--signal);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.65rem;
  }

  .mock-process__steps h3 {
    margin: 0.8rem 0 0;
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 500;
