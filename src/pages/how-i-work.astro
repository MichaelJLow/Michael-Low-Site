---
import Layout from '../components/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import OfferLadder from '../components/OfferLadder.astro';
import CtaBand from '../components/CtaBand.astro';
import { pageTitle, howIWork, whatYouGet, humanControl, notOffered } from '../config/site';
---

<Layout
  title={pageTitle('How I work')}
  description="Discovery and implementation for AI workflow projects. Workflow Review from £350, Workflow Audit from £950, builds from £750."
>
  <div class="inner-v2 hiw">
    <PageHeader label="How I work" title="Start small. Scope properly. Then build." subtitle={howIWork.intro} />

    <section class="inner-v2-section">
      <div class="home-v2-shell">
        <OfferLadder variant="full" />
      </div>
    </section>

    <section class="hiw-band">
      <div class="home-v2-shell hiw-choose">
        <div class="hiw-choose__col">
          <h2>{howIWork.chooseDiscovery.title}</h2>
          <p class="hiw-lede">{howIWork.chooseDiscovery.intro}</p>
          <dl class="hiw-signals">
            {howIWork.chooseDiscovery.rows.map((row) => (
              <div>
                <dt>{row.signal}</dt>
                <dd>{row.steer}</dd>
              </div>
            ))}
          </dl>
          <p class="hiw-note">{howIWork.chooseDiscovery.close}</p>
        </div>

        <div class="hiw-choose__col">
          <h2>{howIWork.chooseBuild.title}</h2>
          <dl class="hiw-signals">
            {howIWork.chooseBuild.rows.map((row) => (
              <div>
                <dt>{row.need}</dt>
                <dd>{row.offer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="inner-v2-section">
      <div class="home-v2-shell">
        <p class="home-v2-kicker">The path</p>
        <h2 class="hiw-h2">Discovery scopes the work. The build is priced from that scope.</h2>
        <ol class="hiw-path">
          {howIWork.path.map((item, index) => (
            <li>
              <span>0{index + 1}</span>
              <div>
                <h3>{item.step}</h3>
                <p>{item.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="hiw-band">
      <div class="home-v2-shell hiw-columns">
        <div>
          <p class="home-v2-kicker">What you get</p>
          <ul class="hiw-list">
            {whatYouGet.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="home-v2-kicker">What stays human controlled</p>
          <ul class="hiw-list">
            {humanControl.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div>
          <p class="home-v2-kicker">What I do not do</p>
          <ul class="hiw-list hiw-list--muted">
            {notOffered.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <CtaBand
      kicker="Next step"
      title="Not sure which one you need?"
      body="Start with a Workflow Review. If the workflow turns out to need deeper scoping, I will tell you and credit the Review in full against an Audit within 30 days."
    />
  </div>
</Layout>

<style>
  .hiw-band {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--ml-paper-raised);
    border-block: 1px solid var(--ml-line);
  }

  .hiw-h2 {
    max-width: 22ch;
    margin: 0.9rem 0 0;
    color: var(--ml-ink);
    font-size: clamp(1.9rem, 3.4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .hiw-choose {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .hiw-choose h2 {
    margin: 0;
    color: var(--ml-ink);
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .hiw-lede {
    max-width: 34rem;
    margin: 0.85rem 0 0;
    color: var(--ml-muted);
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .hiw-signals {
    margin: 1.75rem 0 0;
  }

  .hiw-signals > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 1.5rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ml-line) 70%, transparent);
  }

  .hiw-signals dt {
    color: var(--ml-ink-soft);
    font-size: 0.94rem;
    font-weight: 300;
    line-height: 1.55;
  }

  .hiw-signals dd {
    margin: 0;
    color: var(--ml-ink);
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hiw-note {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--ml-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .hiw-path {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    margin: clamp(2.25rem, 4vw, 3.25rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .hiw-path li {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--ml-line-strong, rgba(48, 47, 43, 0.24));
  }

  .hiw-path span {
    color: var(--ml-clay, #3d5a4c);
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  .hiw-path h3 {
    margin: 0;
    color: var(--ml-ink);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .hiw-path p {
    margin: 0.5rem 0 0;
    color: var(--ml-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .hiw-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .hiw-list {
    display: grid;
    gap: 0.7rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hiw-list li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--ml-ink-soft);
    font-size: 0.93rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .hiw-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.38rem;
    height: 1px;
    background: var(--ml-line-strong, rgba(48, 47, 43, 0.24));
  }

  .hiw-list--muted li {
    color: var(--ml-muted);
  }

  @media (max-width: 980px) {
    .hiw-choose,
    .hiw-columns {
      grid-template-columns: 1fr;
    }

    .hiw-path {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .hiw-path {
      grid-template-columns: 1fr;
    }
  }
</style>
