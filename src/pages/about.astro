---
import Layout from '../components/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, about, pageTitle } from '../config/site';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.founder,
  jobTitle: 'Applied AI systems designer and builder',
  url: `${site.url}/about`,
  sameAs: [site.github, site.linkedin],
  description: site.shortBio,
  image: new URL(site.headshot, site.url).href,
  email: `mailto:${site.email}`,
  worksFor: {
    '@type': 'Organization',
    name: site.brand,
    url: site.url,
  },
};
---

<Layout
  title={pageTitle('About')}
  description="Michael J. Low designs and builds applied AI systems for businesses whose operations have outgrown the tools holding them together."
  jsonLd={personJsonLd}
>
  <div class="inner-v2 about-v2">
    <section class="about-v2__intro" aria-labelledby="about-title">
      <div class="home-v2-shell about-v2__intro-grid">
        <figure class="about-v2__photo">
          <div class="about-v2__frame">
            <img
              src="/images/headshot-studio-tight.png?v=12"
              alt={`${site.founder} portrait`}
              width="819"
              height="1024"
              loading="eager"
              decoding="async"
            />
          </div>
        </figure>

        <div class="about-v2__intro-copy">
          <p class="home-v2-kicker">About</p>
          <h1 id="about-title">I make complicated work easier to operate.</h1>
          <p class="about-v2__lede">{about.intro}</p>
          <div class="about-v2__meta">
            <span>{site.location}</span>
            <span>{site.availabilityShort}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="about-v2__story">
      <div class="home-v2-shell about-v2__story-grid">
        <div class="about-v2__copy">
          <p class="home-v2-kicker">The work</p>
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="about-client">
      <div class="home-v2-shell">
        <header>
          <p class="home-v2-kicker">How I work with clients</p>
          <h2>Four steps, in the same order, every time.</h2>
        </header>
        <ol class="about-client__steps">
          {about.clientWork.map((step, index) => (
            <li>
              <span>0{index + 1}</span>
              <h3>{step.label}</h3>
              <p>{step.detail}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about-v2__principles">
      <div class="home-v2-shell">
        <header>
          <p class="home-v2-kicker">How I show up</p>
          <h2>Practical by default.</h2>
        </header>
        <div class="about-v2__principle-list">
          {about.traits.map((trait, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{trait.label}</h3>
              <p>{trait.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-v2__personal">
      <div class="home-v2-shell">
        <p class="home-v2-kicker">Beyond the work</p>
        <p>{about.personal}</p>
      </div>
    </section>

    <CtaBand
      kicker="Working together"
      title="Have a workflow that is costing you time?"
      body="Book a no-cost workflow review. We will map one process, find where time is being lost, and recommend the highest-value next step, or say so if there is not a worthwhile problem."
    />
  </div>
</Layout>

<style>
  .about-client {
    padding-block: clamp(5rem, 9vw, 8rem);
    background: var(--ml-paper-raised);
    border-bottom: 1px solid var(--ml-line);
  }

  .about-client h2 {
    max-width: 20ch;
    margin: 0.9rem 0 0;
    color: var(--ml-ink);
    font-size: clamp(1.8rem, 3.2vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .about-client__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .about-client__steps li {
    padding-top: 1.15rem;
    border-top: 1px solid var(--ml-line-strong, rgba(48, 47, 43, 0.24));
  }

  .about-client__steps span {
    color: var(--ml-clay, #3d5a4c);
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.65rem;
  }

  .about-client__steps h3 {
    margin: 0.8rem 0 0;
    color: var(--ml-ink);
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .about-client__steps p {
    margin: 0.55rem 0 0;
    color: var(--ml-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
  }

  @media (max-width: 980px) {
    .about-client__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .about-client__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
