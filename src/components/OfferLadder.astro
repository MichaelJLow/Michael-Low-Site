---
import { offerLadder } from '../config/site';

interface Props {
  /** compact = names, prices and who it suits. full = includes and exclusions too. */
  variant?: 'compact' | 'full';
}

const { variant = 'compact' } = Astro.props;
const full = variant === 'full';
---

<div class:list={['ladder', full && 'ladder--full']}>
  {offerLadder.groups.map((group) => (
    <section class="ladder__group">
      <header class="ladder__group-head">
        <h3>{group.name}</h3>
        <p>{group.summary}</p>
      </header>

      <div class="ladder__tiers">
        {group.tiers.map((tier) => (
          <article class="ladder__tier">
            <div class="ladder__tier-head">
              <h4>{tier.name}</h4>
              <span class="ladder__price">{tier.price}</span>
            </div>
            <p class="ladder__job">{tier.job}</p>
            <p class="ladder__best-for"><span>Best for:</span> {tier.bestFor}</p>

            {full && (
              <>
                <p class="ladder__label">Includes</p>
                <ul class="ladder__list">
                  {tier.includes.map((item) => <li>{item}</li>)}
                </ul>

                {'excludes' in tier && tier.excludes && (
                  <>
                    <p class="ladder__label">Does not include</p>
                    <ul class="ladder__list ladder__list--muted">
                      {tier.excludes.map((item) => <li>{item}</li>)}
                    </ul>
                  </>
                )}

                {'note' in tier && tier.note && <p class="ladder__note">{tier.note}</p>}
              </>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}
</div>

<p class="ladder__supporting">{offerLadder.supportingLine}</p>
<p class="ladder__credit">{offerLadder.creditLine}</p>
{full && <p class="ladder__credit">{offerLadder.scopeLine}</p>}

<style>
  .ladder {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .ladder__group {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--ml-line);
    align-items: start;
  }

  .ladder__group-head h3 {
    margin: 0;
    color: var(--ml-ink);
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .ladder__group-head p {
    max-width: 24rem;
    margin: 0.7rem 0 0;
    color: var(--ml-muted);
    font-size: 0.94rem;
    font-weight: 300;
    line-height: 1.65;
  }

  .ladder__tiers {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .ladder--full .ladder__tiers {
    gap: clamp(2rem, 4vw, 3rem);
  }

  .ladder__tier {
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid color-mix(in srgb, var(--ml-line) 70%, transparent);
  }

  .ladder__tier:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .ladder__tier-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .ladder__tier-head h4 {
    margin: 0;
    color: var(--ml-ink);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .ladder__price {
    color: var(--ml-ink);
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ladder__job {
    max-width: 42rem;
    margin: 0.6rem 0 0;
    color: var(--ml-ink-soft);
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .ladder__best-for {
    max-width: 42rem;
    margin: 0.55rem 0 0;
    color: var(--ml-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .ladder__best-for span {
    color: var(--ml-ink-soft);
  }

  .ladder__label {
    margin: 1.35rem 0 0;
    color: var(--ml-muted);
    font-family: var(--font-mono, 'IBM Plex Mono', ui-monospace, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ladder__list {
    display: grid;
    gap: 0.45rem;
    max-width: 42rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ladder__list li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--ml-ink-soft);
    font-size: 0.92rem;
    font-weight: 300;
    line-height: 1.55;
  }

  .ladder__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.38rem;
    height: 1px;
    background: var(--ml-line-strong, rgba(48, 47, 43, 0.24));
  }

  .ladder__list--muted li {
    color: var(--ml-muted);
  }

  .ladder__note {
    margin: 1rem 0 0;
    color: var(--ml-muted);
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .ladder__supporting,
  .ladder__credit {
    max-width: 52rem;
    margin: 0;
    color: var(--ml-muted);
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .ladder__supporting {
    margin-top: clamp(2.25rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--ml-line);
  }

  .ladder__credit {
    margin-top: 0.75rem;
  }

  @media (max-width: 860px) {
    .ladder__group {
      grid-template-columns: 1fr;
    }
  }
</style>
