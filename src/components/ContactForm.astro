---
interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const formClass = variant === 'home' ? 'layer-form' : 'contact-form';
const buttonClass = variant === 'home' ? 'layer-button layer-button--light' : 'contact-page__button';
---

<form class={formClass} data-review-form novalidate>
  <input class="contact-honeypot" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class={`${formClass}__row`}>
    <label>
      <span>Name</span>
      <input name="name" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>Work email</span>
      <input name="email" type="email" autocomplete="email" required />
    </label>
  </div>
  <label>
    <span>Company <em>(optional)</em></span>
    <input name="company" type="text" autocomplete="organization" />
  </label>
  <label>
    <span>Where is work getting stuck?</span>
    <textarea
      name="message"
      rows="4"
      required
      placeholder="The process, the tools, and what the team is still doing by hand."></textarea>
  </label>
  <button class={buttonClass} type="submit">
    Request a no-cost review <span aria-hidden="true">↗</span>
  </button>
  <p class={`${formClass}__status`} data-form-status aria-live="polite"></p>
</form>

<style>
  .contact-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form {
    display: grid;
    gap: 1.15rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .contact-form label {
    display: grid;
    gap: 0.5rem;
  }

  .contact-form label > span,
  .layer-form label em,
  .contact-form label em {
    font-style: normal;
  }

  .contact-form label em,
  .layer-form label em {
    opacity: 0.62;
  }

  .contact-form label > span {
    color: var(--ml-ink-soft, #3a4250);
    font-size: 0.78rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--ml-line-strong, rgba(18, 21, 26, 0.16));
    border-radius: 0.2rem;
    outline: none;
    color: var(--ml-ink, #12151a);
    background: #fff;
    font: inherit;
    font-size: 0.95rem;
    padding: 0.7rem 0.85rem;
  }

  .contact-form input {
    min-height: 2.7rem;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 7.5rem;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--ml-ink, #12151a);
  }

  .contact-form__status {
    min-height: 1.2em;
    margin: 0;
    color: var(--ml-muted, #5c6570);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('[data-review-form]');

  forms.forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        company: String(data.get('company') || '').trim(),
        message: String(data.get('message') || '').trim(),
        website: String(data.get('website') || '').trim(),
      };

      if (!payload.name || !payload.email || !payload.message) {
        if (status) status.textContent = 'Please add your name, work email, and a short note about the workflow.';
        return;
      }

      if (button) button.disabled = true;
      if (status) status.textContent = 'Sending…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !result.ok) {
          throw new Error(result.error || 'Could not send the request.');
        }

        form.reset();
        if (status) {
          status.textContent = 'Thanks. We will reply within one working day to arrange the conversation.';
        }
      } catch (error) {
        if (status) {
          status.textContent =
            error instanceof Error
              ? error.message
              : 'Something went wrong. Email contact@workwithlayer.com and it will reach us directly.';
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  });
</script>
