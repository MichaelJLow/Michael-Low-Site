---
import { site, footerNav } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer-v2">
  <div class="site-footer-v2__inner">
    <div class="site-footer-v2__main">
      <div>
        <a href="/" class="site-footer-v2__name" aria-label="Layer">
          layer<span aria-hidden="true">.</span>
        </a>
        <p>Controlled AI systems for the way your business actually works.</p>
        <p class="site-footer-v2__contact">
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <nav aria-label="Footer navigation">
        {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </nav>
    </div>

    <div class="site-footer-v2__meta">
      <span>© {year} {site.name}</span>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer-v2 {
    --foot-paper: var(--ml-paper, #f7f8fa);
    --foot-ink: var(--ml-ink, #12151a);
    --foot-soft: var(--ml-ink-soft, #3a4250);
    --foot-muted: var(--ml-muted, #5c6570);
    --foot-line: var(--ml-line, rgba(18, 21, 26, 0.1));
    --foot-shell: var(--ml-shell, min(92rem, calc(100% - 3rem)));
    color: var(--foot-ink);
    background: var(--foot-paper);
    border-top: 1px solid var(--foot-line);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .site-footer-v2__inner {
    width: var(--foot-shell);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
    padding-block: clamp(1.1rem, 2.2vw, 1.65rem) clamp(0.7rem, 1.4vw, 1rem);
  }

  .site-footer-v2__main {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .site-footer-v2__name {
    color: var(--foot-ink);
    font-size: 1.75rem;
    font-weight: 450;
    letter-spacing: -0.065em;
    text-decoration: none;
  }

  .site-footer-v2__name span {
    color: #1d3557;
  }

  .site-footer-v2 p {
    max-width: 34rem;
    margin: 0.35rem 0 0;
    color: var(--foot-muted);
    font-size: 0.88rem;
    font-weight: 300;
    line-height: 1.6;
  }

  .site-footer-v2__contact {
    display: grid;
    gap: 0.35rem;
  }

  .site-footer-v2__contact a {
    color: var(--foot-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .site-footer-v2__contact a:hover {
    color: var(--foot-soft);
  }

  .site-footer-v2 nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.4rem;
    justify-content: flex-end;
  }

  .site-footer-v2 nav a {
    color: var(--foot-soft);
    font-size: 0.88rem;
    text-decoration: none;
  }

  .site-footer-v2 nav a:hover {
    color: var(--foot-ink);
  }

  .site-footer-v2__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding-top: 0.55rem;
    border-top: 1px solid var(--foot-line);
    color: var(--foot-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .site-footer-v2__meta a {
    color: var(--foot-muted);
    text-decoration: none;
  }

  .site-footer-v2__meta a:hover {
    color: var(--foot-ink);
  }

  @media (max-width: 980px) {
    .site-footer-v2__inner {
      width: min(100% - 2rem, 60rem);
    }

    .site-footer-v2__main {
      grid-template-columns: 1fr;
    }

    .site-footer-v2 nav {
      justify-content: flex-start;
    }

    .site-footer-v2__meta {
      justify-content: flex-start;
    }
  }
</style>
