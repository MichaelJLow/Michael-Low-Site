---
import { site, primaryCta, discoveryCall } from '../config/site';

interface Props {
  kicker?: string;
  title?: string;
  body?: string;
  showFitCheck?: boolean;
}

const {
  kicker = 'Next step',
  title = 'Have a workflow like this?',
  body = discoveryCall.intro,
  showFitCheck = false,
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="cta-band__inner">
    <div>
      <p class="cta-band__kicker">{kicker}</p>
      <h2 id="cta-band-title">{title}</h2>
    </div>
    <div class="cta-band__copy">
      <p>{body}</p>
      <div class="cta-band__actions">
        <a class="cta-band__button" href={primaryCta.href}>
          {primaryCta.label} <span aria-hidden="true">↗</span>
        </a>
        <span class="cta-band__price">{primaryCta.note}</span>
      </div>
      {showFitCheck && (
        <p class="cta-band__fit">
          Prefer email first?
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      )}
      <a class="cta-band__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #f7f8fa;
    background: #12151a;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .cta-band__inner {
    position: relative;
    z-index: 1;
    width: var(--ml-shell, min(92rem, calc(100% - 3rem)));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    align-items: end;
  }

  .cta-band__kicker {
    margin: 0;
    color: color-mix(in srgb, #f7f8fa 62%, transparent);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-band h2 {
    max-width: 16ch;
    margin: 0.85rem 0 0;
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .cta-band__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .cta-band__copy > p {
    margin: 0;
    color: color-mix(in srgb, #f7f8fa 72%, transparent);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.7;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .cta-band__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.4rem;
    padding: 0.9rem 1.4rem;
    border-radius: 0.35rem;
    color: #12151a;
    background: #f7f8fa;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid #f7f8fa;
  }

  .cta-band__button:hover {
    background: #ffffff;
  }

  .cta-band__price {
    color: color-mix(in srgb, #f7f8fa 62%, transparent);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cta-band__fit {
    margin: 0;
    color: color-mix(in srgb, #f7f8fa 70%, transparent);
    font-size: 0.92rem;
  }

  .cta-band__fit a {
    margin-left: 0.35rem;
    color: #7ba7c9;
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .cta-band__email {
    color: color-mix(in srgb, #f7f8fa 72%, transparent);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .cta-band__email:hover {
    color: #f7f8fa;
  }

  @media (max-width: 980px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
