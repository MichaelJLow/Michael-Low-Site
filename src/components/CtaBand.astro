---
import { site, primaryCta, contact } from '../config/site';

interface Props {
  kicker?: string;
  title?: string;
  body?: string;
}

const {
  kicker = 'Next step',
  title = 'Have a workflow like this?',
  body = 'Start with a Workflow Review: one working session on a single workflow, a short written summary, and an honest recommendation on whether it is worth automating.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="cta-band__inner">
    <div>
      <p class="cta-band__kicker">{kicker}</p>
      <h2 id="cta-band-title">{title}</h2>
    </div>
    <div class="cta-band__copy">
      <p>{body}</p>
      <div class="cta-band__actions">
        <a class="cta-band__button" href={primaryCta.href}>
          {primaryCta.label} <span aria-hidden="true">↗</span>
        </a>
        <span class="cta-band__price">{contact.price}</span>
      </div>
      <a class="cta-band__email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #f4f0e8;
    background:
      radial-gradient(ellipse 80% 55% at 50% -10%, rgba(255, 255, 255, 0.05) 0%, transparent 55%),
      #202220;
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .cta-band__inner {
    position: relative;
    z-index: 1;
    width: var(--ml-shell, min(92rem, calc(100% - 3rem)));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: clamp(2.5rem, 7vw, 8rem);
    align-items: end;
  }

  .cta-band__kicker {
    margin: 0;
    color: color-mix(in srgb, #f4f0e8 62%, transparent);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cta-band h2 {
    max-width: 16ch;
    margin: 0.85rem 0 0;
    font-size: clamp(2.2rem, 4.2vw, 4rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .cta-band__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .cta-band__copy > p {
    margin: 0;
    color: color-mix(in srgb, #f4f0e8 68%, transparent);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
  }

  .cta-band__button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.4rem;
    padding: 0.9rem 1.4rem;
    border-radius: 0.35rem;
    color: #202220;
    background: #f4f0e8;
    font-size: 0.98rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cta-band__button:hover {
    transform: translateY(-2px);
  }

  .cta-band__button span {
    transition: transform 180ms ease;
  }

  .cta-band__button:hover span {
    transform: translate(2px, -2px);
  }

  .cta-band__price {
    color: color-mix(in srgb, #f4f0e8 62%, transparent);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cta-band__email {
    color: color-mix(in srgb, #f4f0e8 72%, transparent);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .cta-band__email:hover {
    color: #f4f0e8;
  }

  @media (max-width: 980px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
