---
interface ShotFocus {
  /** Left edge of highlight as % from left (0–100). */
  x: number;
  /** Top edge of highlight as % from top (0–100). */
  y: number;
  /** Highlight width as % of image (0–100). */
  w: number;
  /** Highlight height as % of image (0–100). */
  h: number;
}

interface Shot {
  image: string;
  alt: string;
  label?: string;
  note?: string;
  /** Optional highlight region; click expands that area. */
  focus?: ShotFocus;
}

interface Props {
  shots: Shot[];
  frameLabel?: string;
  idPrefix?: string;
  /** Wider presentation for case-study feature moments. */
  feature?: boolean;
}

const { shots, frameLabel = 'libertrade.app', idPrefix = 'loop-frame', feature = false } = Astro.props;
const hasMultipleShots = shots.length > 1;
const firstLabel = shots[0]?.label ?? `Screen 1`;
const firstNote = shots[0]?.note ?? '';
---

{
  shots.length > 0 && (
    <figure
      class:list={['browser-shot-carousel', feature && 'browser-shot-carousel--feature']}
      data-snapshot-carousel
      aria-label="Product workflow walkthrough"
    >
      <div class="product-frame__bar" aria-hidden="true">
        <span class="product-frame__dots"><i></i><i></i><i></i></span>
        <span class="product-frame__label">{frameLabel}</span>
        <span></span>
      </div>

      <div
        class="browser-shot-carousel__track"
        tabindex={hasMultipleShots ? 0 : undefined}
        data-snapshot-track
      >
        {shots.map((shot, index) => (
          <div
            class="browser-shot-carousel__slide"
            id={`${idPrefix}-${index + 1}`}
            data-snapshot-slide
            data-snapshot-label={shot.label ?? `Screen ${index + 1}`}
            data-snapshot-note={shot.note ?? ''}
          >
            <div class="browser-shot-carousel__media">
              <img src={shot.image} alt={shot.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              {shot.focus && (
                <button
                  type="button"
                  class="browser-shot-carousel__hotspot"
                  style={`left:${shot.focus.x}%;top:${shot.focus.y}%;width:${shot.focus.w}%;height:${shot.focus.h}%`}
                  aria-label={`Expand detail: ${shot.label ?? `screen ${index + 1}`}`}
                  data-snapshot-hotspot
                  data-hotspot-src={shot.image}
                  data-hotspot-alt={shot.alt}
                  data-hotspot-label={shot.label ?? `Screen ${index + 1}`}
                  data-hotspot-x={String(shot.focus.x)}
                  data-hotspot-y={String(shot.focus.y)}
                  data-hotspot-w={String(shot.focus.w)}
                  data-hotspot-h={String(shot.focus.h)}
                >
                  <span class="browser-shot-carousel__hotspot-label">Click to expand</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="browser-shot-carousel__caption-bar" data-snapshot-live-caption aria-live="polite">
        <span data-snapshot-live-index>{String(1).padStart(2, '0')}</span>
        <div class="browser-shot-carousel__caption-copy">
          <p class="browser-shot-carousel__caption-label" data-snapshot-live-label>{firstLabel}</p>
          <p class="browser-shot-carousel__caption-note" data-snapshot-live-note>{firstNote}</p>
        </div>
      </div>

      {hasMultipleShots && (
        <nav class="browser-shot-carousel__nav" aria-label="Workflow screen navigation">
          {shots.map((shot, index) => (
            <a
              href={`#${idPrefix}-${index + 1}`}
              aria-current={index === 0 ? 'true' : undefined}
              aria-label={`View ${shot.label ?? `screen ${index + 1}`}${shot.note ? `: ${shot.note}` : ''}`}
              data-snapshot-indicator
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </a>
          ))}
        </nav>
      )}
    </figure>
  )
}

{/* Shared lightbox lives outside the overflow-hidden carousel so it can center on screen. */}
{
  shots.some((shot) => shot.focus) && (
    <dialog class="browser-shot-lightbox" data-snapshot-lightbox aria-label="Expanded screenshot detail">
      <form method="dialog" class="browser-shot-lightbox__panel">
        <header class="browser-shot-lightbox__header">
          <p class="browser-shot-lightbox__title" data-lightbox-title></p>
          <button type="submit" class="browser-shot-lightbox__close" data-lightbox-close aria-label="Close expanded view">
            <span aria-hidden="true">×</span>
            Close
          </button>
        </header>
        <div class="browser-shot-lightbox__crop" data-lightbox-crop>
          <img src="" alt="" data-lightbox-image />
        </div>
        <p class="browser-shot-lightbox__hint">Press Escape or click outside to close</p>
      </form>
    </dialog>
  )
}

<style>
  .browser-shot-carousel {
    background: #e9e7e1;
    border: 1px solid rgba(48, 47, 43, 0.22);
    border-radius: 0.55rem;
    box-shadow: 0 0.8rem 2rem rgba(48, 47, 43, 0.08);
    margin: 0;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .browser-shot-carousel--feature {
    border-radius: 0.65rem;
    box-shadow:
      0 1.5rem 3.5rem rgba(18, 18, 16, 0.12),
      0 0 0 1px rgba(48, 47, 43, 0.08);
  }

  .browser-shot-carousel--feature .browser-shot-carousel__caption-bar {
    align-items: start;
    min-height: 4.75rem;
    padding: 1rem 1.15rem;
  }

  .product-frame__bar {
    align-items: center;
    background: rgba(48, 47, 43, 0.035);
    border-bottom: 1px solid rgba(48, 47, 43, 0.14);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 2rem;
    padding: 0 0.75rem;
  }

  .product-frame__dots {
    display: flex;
    gap: 0.3rem;
  }

  .product-frame__dots i {
    background: rgba(48, 47, 43, 0.28);
    border-radius: 50%;
    display: block;
    height: 0.38rem;
    width: 0.38rem;
  }

  .product-frame__label {
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.58rem;
    letter-spacing: 0.05em;
    line-height: 1;
  }

  .browser-shot-carousel__track {
    display: flex;
    gap: 0;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .browser-shot-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .browser-shot-carousel__track:focus-visible {
    outline: 2px solid var(--ml-line-strong, var(--ml-line));
    outline-offset: -2px;
  }

  .browser-shot-carousel__slide {
    box-sizing: border-box;
    display: flex;
    flex: 0 0 100%;
    flex-direction: column;
    margin: 0;
    max-width: 100%;
    min-width: 0;
    scroll-snap-align: start;
    width: 100%;
  }

  .browser-shot-carousel__media {
    align-items: center;
    aspect-ratio: 16 / 9;
    background: #e9e7e1;
    display: flex;
    justify-content: center;
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .browser-shot-carousel__media img {
    display: block;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    width: 100%;
  }

  .browser-shot-carousel__hotspot {
    background: rgba(48, 47, 43, 0.04);
    border: 1.5px solid rgba(48, 47, 43, 0.28);
    border-radius: 0.3rem;
    box-shadow: none;
    cursor: zoom-in;
    padding: 0;
    position: absolute;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease;
    z-index: 2;
  }

  .browser-shot-carousel__hotspot:hover,
  .browser-shot-carousel__hotspot:focus-visible {
    background: rgba(48, 47, 43, 0.08);
    border-color: rgba(48, 47, 43, 0.45);
    box-shadow: 0 0.25rem 0.8rem rgba(48, 47, 43, 0.1);
    outline: none;
  }

  .browser-shot-carousel__hotspot-label {
    background: rgba(48, 47, 43, 0.72);
    border-radius: 999px;
    bottom: 0.3rem;
    color: #f7f6f1;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.56rem;
    letter-spacing: 0.06em;
    left: 50%;
    line-height: 1;
    opacity: 0;
    padding: 0.28rem 0.5rem;
    pointer-events: none;
    position: absolute;
    text-transform: uppercase;
    transform: translateX(-50%);
    transition: opacity 160ms ease;
    white-space: nowrap;
  }

  .browser-shot-carousel__hotspot:hover .browser-shot-carousel__hotspot-label,
  .browser-shot-carousel__hotspot:focus-visible .browser-shot-carousel__hotspot-label {
    opacity: 1;
  }

  .browser-shot-carousel__caption-bar {
    align-items: start;
    background: rgba(48, 47, 43, 0.02);
    border-top: 1px solid rgba(48, 47, 43, 0.14);
    display: grid;
    gap: 0.85rem;
    grid-template-columns: auto minmax(0, 1fr);
    min-height: 4.25rem;
    padding: 0.95rem 1rem;
  }

  .browser-shot-carousel__caption-bar > span {
    color: var(--ml-clay);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.45;
    padding-top: 0.1rem;
  }

  .browser-shot-carousel__caption-copy {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .browser-shot-carousel__caption-label {
    margin: 0;
    color: var(--ml-ink);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-transform: none;
  }

  .browser-shot-carousel__caption-note {
    margin: 0;
    color: var(--ml-ink-soft);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.84rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
    text-transform: none;
  }

  .browser-shot-carousel__caption-note:empty {
    display: none;
  }

  .browser-shot-carousel__nav {
    border-top: 1px solid rgba(48, 47, 43, 0.1);
    display: grid;
    gap: 0.45rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0.75rem;
  }

  .browser-shot-carousel__nav a {
    align-items: center;
    border: 1px solid var(--ml-line);
    border-radius: 0.35rem;
    color: var(--ml-muted);
    display: inline-flex;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.65rem;
    height: 2.15rem;
    justify-content: center;
    letter-spacing: 0.08em;
    min-width: 0;
    text-decoration: none;
    width: 100%;
  }

  .browser-shot-carousel__nav a:hover,
  .browser-shot-carousel__nav a:focus-visible,
  .browser-shot-carousel__nav a[aria-current='true'] {
    background: var(--ml-ink);
    border-color: var(--ml-ink);
    color: #f7f6f1;
  }

  @media (min-width: 640px) {
    .browser-shot-carousel__nav {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .browser-shot-lightbox {
    background: transparent;
    border: none;
    max-height: none;
    max-width: none;
    padding: 0;
    width: auto;
  }

  .browser-shot-lightbox[open] {
    box-sizing: border-box;
    display: grid;
    height: 100%;
    inset: 0;
    margin: 0;
    max-height: none;
    max-width: none;
    overflow: auto;
    padding: 1.25rem;
    place-items: center;
    position: fixed;
    width: 100%;
  }

  .browser-shot-lightbox::backdrop {
    background: rgba(28, 27, 24, 0.68);
    backdrop-filter: blur(4px);
  }

  .browser-shot-lightbox__panel {
    background: #f7f6f1;
    border: 1px solid rgba(48, 47, 43, 0.14);
    border-radius: 0.85rem;
    box-shadow: 0 1.5rem 3.5rem rgba(18, 18, 16, 0.28);
    box-sizing: border-box;
    display: grid;
    gap: 0.85rem;
    margin: 0;
    max-height: min(90vh, 52rem);
    max-width: min(92vw, 72rem);
    overflow-x: hidden;
    overflow-y: auto;
    padding: 1rem 1.15rem 1.05rem;
    width: min(92vw, 72rem);
  }

  .browser-shot-lightbox__header {
    align-items: center;
    background: #f7f6f1;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    min-width: 0;
    padding-right: 0.1rem;
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 3;
  }

  .browser-shot-lightbox__title {
    color: var(--ml-ink);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-shot-lightbox__close {
    align-items: center;
    background: var(--ml-ink);
    border: 1px solid var(--ml-ink);
    border-radius: 999px;
    color: #f7f6f1;
    cursor: pointer;
    display: inline-flex;
    flex: 0 0 auto;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 600;
    gap: 0.3rem;
    letter-spacing: 0.01em;
    line-height: 1;
    margin-left: auto;
    padding: 0.55rem 0.95rem 0.55rem 0.8rem;
    white-space: nowrap;
  }

  .browser-shot-lightbox__close span {
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 0.8;
  }

  .browser-shot-lightbox__close:hover,
  .browser-shot-lightbox__close:focus-visible {
    background: #1f1e1b;
    outline: 2px solid rgba(48, 47, 43, 0.25);
    outline-offset: 2px;
  }

  .browser-shot-lightbox__crop {
    background: #e9e7e1;
    border: 1px solid rgba(48, 47, 43, 0.14);
    border-radius: 0.5rem;
    box-sizing: border-box;
    margin-inline: auto;
    max-width: 100%;
    overflow: hidden;
    position: relative;
  }

  .browser-shot-lightbox__crop img {
    display: block;
    max-width: none;
    position: absolute;
  }

  .browser-shot-lightbox__hint {
    color: var(--ml-muted);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    margin: 0;
    text-align: center;
  }
</style>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-snapshot-carousel]');

  carousels.forEach((carousel) => {
    if (carousel.dataset.snapshotCarouselEnhanced === 'true') return;

    const track = carousel.querySelector<HTMLElement>('[data-snapshot-track]');
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-snapshot-slide]'));
    const indicators = Array.from(carousel.querySelectorAll<HTMLElement>('[data-snapshot-indicator]'));
    const liveIndex = carousel.querySelector<HTMLElement>('[data-snapshot-live-index]');
    const liveLabel = carousel.querySelector<HTMLElement>('[data-snapshot-live-label]');
    const liveNote = carousel.querySelector<HTMLElement>('[data-snapshot-live-note]');
    // Lightbox is a sibling after the figure (outside overflow:hidden).
    const lightbox =
      carousel.parentElement?.querySelector<HTMLDialogElement>(':scope > [data-snapshot-lightbox]') ??
      document.querySelector<HTMLDialogElement>('[data-snapshot-lightbox]');
    const lightboxCrop = lightbox?.querySelector<HTMLElement>('[data-lightbox-crop]');
    const lightboxImage = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const lightboxTitle = lightbox?.querySelector<HTMLElement>('[data-lightbox-title]');
    const hotspots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-snapshot-hotspot]'));

    if (!track || slides.length === 0) return;

    carousel.dataset.snapshotCarouselEnhanced = 'true';

    // Keep the modal on document.body so fixed centering is never clipped by ancestors.
    if (lightbox && lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    const medias = Array.from(carousel.querySelectorAll<HTMLElement>('.browser-shot-carousel__media'));
    const images = Array.from(carousel.querySelectorAll<HTMLImageElement>('.browser-shot-carousel__media img'));

    const syncMediaHeight = () => {
      if (!track || medias.length === 0 || images.length === 0) return;

      const trackWidth = track.clientWidth;
      if (trackWidth <= 0) return;

      let maxHeight = 0;

      images.forEach((image) => {
        if (!image.naturalWidth || !image.naturalHeight) return;

        const scaledHeight = (image.naturalHeight / image.naturalWidth) * trackWidth;
        maxHeight = Math.max(maxHeight, scaledHeight);
      });

      if (maxHeight <= 0) return;

      const heightPx = `${Math.ceil(maxHeight)}px`;
      medias.forEach((media) => {
        media.style.height = heightPx;
        media.style.minHeight = heightPx;
      });
    };

    const queueHeightSync = () => {
      syncMediaHeight();
      window.requestAnimationFrame(syncMediaHeight);
    };

    images.forEach((image) => {
      if (image.complete) return;
      image.addEventListener('load', queueHeightSync, { once: true });
    });

    queueHeightSync();
    window.addEventListener('resize', queueHeightSync);

    const setActiveSlide = (activeIndex: number) => {
      const slide = slides[activeIndex];
      if (!slide) return;

      indicators.forEach((indicator, index) => {
        if (index === activeIndex) {
          indicator.setAttribute('aria-current', 'true');
        } else {
          indicator.removeAttribute('aria-current');
        }
      });

      if (liveIndex) {
        liveIndex.textContent = String(activeIndex + 1).padStart(2, '0');
      }

      if (liveLabel) {
        liveLabel.textContent = slide.dataset.snapshotLabel ?? `Screen ${activeIndex + 1}`;
      }

      if (liveNote) {
        liveNote.textContent = slide.dataset.snapshotNote ?? '';
      }
    };

    let activeHotspot: HTMLButtonElement | null = null;

    const layoutLightboxCrop = (xPct: number, yPct: number, wPct: number, hPct: number) => {
      if (!lightboxCrop || !lightboxImage) return;
      if (!lightboxImage.naturalWidth || !lightboxImage.naturalHeight) return;

      const natW = lightboxImage.naturalWidth;
      const natH = lightboxImage.naturalHeight;
      const regionW = (wPct / 100) * natW;
      const regionH = (hPct / 100) * natH;

      // Enlarge the crop, but leave room for panel padding so the Close button never clips.
      const maxW = Math.min(window.innerWidth * 0.92 - 56, 68 * 16);
      const maxH = window.innerHeight * 0.7;
      const scale = Math.min(maxW / regionW, maxH / regionH);

      const displayW = regionW * scale;
      const displayH = regionH * scale;

      lightboxCrop.style.width = `${Math.round(displayW)}px`;
      lightboxCrop.style.height = `${Math.round(displayH)}px`;

      lightboxImage.style.width = `${Math.round(natW * scale)}px`;
      lightboxImage.style.height = `${Math.round(natH * scale)}px`;
      lightboxImage.style.left = `${Math.round(-((xPct / 100) * natW * scale))}px`;
      lightboxImage.style.top = `${Math.round(-((yPct / 100) * natH * scale))}px`;
    };

    const openHotspot = (hotspot: HTMLButtonElement) => {
      if (!lightbox || !lightboxImage || !lightboxTitle) return;

      const src = hotspot.dataset.hotspotSrc;
      const alt = hotspot.dataset.hotspotAlt ?? '';
      const label = hotspot.dataset.hotspotLabel ?? 'Detail';
      const x = Number(hotspot.dataset.hotspotX);
      const y = Number(hotspot.dataset.hotspotY);
      const w = Number(hotspot.dataset.hotspotW);
      const h = Number(hotspot.dataset.hotspotH);

      // x/y may be 0 (flush to an edge); only width/height must be positive.
      if (!src || ![x, y, w, h].every((value) => Number.isFinite(value)) || w <= 0 || h <= 0) return;

      activeHotspot = hotspot;
      lightboxTitle.textContent = label;
      lightboxImage.alt = alt;

      const show = () => {
        layoutLightboxCrop(x, y, w, h);
        if (typeof lightbox.showModal === 'function') {
          lightbox.showModal();
        } else {
          lightbox.setAttribute('open', '');
        }
      };

      if (lightboxImage.getAttribute('src') === src && lightboxImage.complete && lightboxImage.naturalWidth > 0) {
        show();
        return;
      }

      lightboxImage.src = src;
      if (lightboxImage.complete && lightboxImage.naturalWidth > 0) {
        show();
      } else {
        lightboxImage.addEventListener('load', show, { once: true });
      }
    };

    hotspots.forEach((hotspot) => {
      hotspot.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        openHotspot(hotspot);
      });
    });

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        lightbox.close();
      }
    });

    window.addEventListener('resize', () => {
      if (!lightbox?.open || !activeHotspot) return;
      layoutLightboxCrop(
        Number(activeHotspot.dataset.hotspotX),
        Number(activeHotspot.dataset.hotspotY),
        Number(activeHotspot.dataset.hotspotW),
        Number(activeHotspot.dataset.hotspotH),
      );
    });

    if (slides.length < 2) {
      setActiveSlide(0);
      return;
    }

    if (indicators.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const activeIndex = slides.indexOf(entry.target as HTMLElement);
          if (activeIndex >= 0) setActiveSlide(activeIndex);
        });
      },
      { root: track, threshold: 0.62 },
    );

    slides.forEach((slide) => observer.observe(slide));
    setActiveSlide(0);
  });
</script>
