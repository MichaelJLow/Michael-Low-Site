---
import { site, nav, primaryCta } from '../config/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const mainLinks = nav.filter((item) => item.href !== '/contact');
---

<header class="site-nav" data-site-nav>
  <nav class="site-nav__inner" aria-label="Primary navigation">
    <a class="site-nav__brand" href="/">
      <span class="site-nav__brand-name">{site.name}</span>
      <span class="site-nav__brand-practice">{site.practice}</span>
    </a>

    <div class="site-nav__links">
      {mainLinks.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </div>

    <div class="site-nav__actions">
      <span class="site-nav__availability"><i aria-hidden="true"></i>{site.availabilityShort}</span>
      <a class="site-nav__cta" href={primaryCta.href}>Start a Workflow Review</a>
      <details class="site-nav__menu">
        <summary>Menu</summary>
        <div>
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    --nav-paper: var(--ml-paper, #f4f0e8);
    --nav-ink: var(--ml-ink, #1d1f1e);
    --nav-soft: var(--ml-ink-soft, #454744);
    --nav-muted: var(--ml-muted, #77756f);
    --nav-line: var(--ml-line, rgba(48, 47, 43, 0.14));
    --nav-shell: var(--ml-shell, min(92rem, calc(100% - 3rem)));
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, var(--nav-paper) 88%, transparent);
    border-bottom: 1px solid var(--nav-line);
    backdrop-filter: blur(18px) saturate(120%);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .site-nav__inner {
    width: var(--nav-shell);
    min-height: 5.6rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .site-nav__brand {
    justify-self: start;
    display: grid;
    gap: 0.1rem;
    text-decoration: none;
    line-height: 1.15;
  }

  .site-nav__brand-name {
    color: var(--nav-ink);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .site-nav__brand-practice {
    color: var(--nav-muted);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .site-nav__links a,
  .site-nav__menu a {
    color: var(--nav-soft);
    font-size: 0.94rem;
    text-decoration: none;
  }

  .site-nav__links a:hover,
  .site-nav__menu a:hover {
    color: var(--nav-ink);
  }

  .site-nav__links a[aria-current='page'],
  .site-nav__menu a[aria-current='page'] {
    color: var(--nav-ink);
    font-weight: 500;
  }

  .site-nav__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-nav__availability {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--nav-muted);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .site-nav__availability i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #638067;
    box-shadow: 0 0 0 3px rgba(99, 128, 103, 0.1);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.62rem 1.05rem;
    border-radius: 0.3rem;
    color: var(--nav-paper);
    background: var(--nav-ink);
    font-size: 0.86rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease;
  }

  .site-nav__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(31, 31, 28, 0.16);
  }

  .site-nav__menu {
    display: none;
    position: relative;
  }

  .site-nav__menu summary {
    color: var(--nav-ink);
    font-size: 0.85rem;
    cursor: pointer;
    list-style: none;
  }

  .site-nav__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__menu > div {
    position: absolute;
    top: 2.2rem;
    right: 0;
    min-width: 13rem;
    display: grid;
    padding: 0.7rem;
    background: var(--ml-paper-raised, #faf7f1);
    border: 1px solid var(--nav-line);
    box-shadow: 0 18px 50px rgba(32, 30, 25, 0.12);
  }

  .site-nav__menu a {
    padding: 0.7rem 0.8rem;
  }

  @media (max-width: 1180px) {
    .site-nav__availability {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .site-nav__inner {
      grid-template-columns: 1fr auto;
      width: min(100% - 2rem, 60rem);
    }

    .site-nav__links {
      display: none;
    }

    .site-nav__menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .site-nav__cta {
      display: none;
    }
  }
</style>
