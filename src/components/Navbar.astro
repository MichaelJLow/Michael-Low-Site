---
import { site, nav, primaryCta } from '../config/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const mainLinks = nav;
---

<header class="site-nav" data-site-nav>
  <nav class="site-nav__inner" aria-label="Primary navigation">
    <a class="site-nav__brand" href="/">
      <span class="site-nav__wordmark" aria-label="Layer">
        layer<b>.</b>
      </span>
    </a>

    <div class="site-nav__links">
      {mainLinks.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </div>

    <div class="site-nav__actions">
      <a class="site-nav__cta" href={primaryCta.href}>{primaryCta.shortLabel}</a>
      <details class="site-nav__menu">
        <summary>Menu</summary>
        <div>
          {nav.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    --nav-paper: var(--ml-paper, #f7f8fa);
    --nav-ink: var(--ml-ink, #12151a);
    --nav-soft: var(--ml-ink-soft, #3a4250);
    --nav-muted: var(--ml-muted, #5c6570);
    --nav-line: var(--ml-line, rgba(18, 21, 26, 0.1));
    --nav-shell: var(--ml-shell, min(92rem, calc(100% - 3rem)));
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in srgb, #f6f4ef 90%, transparent);
    border-bottom: 1px solid var(--nav-line);
    backdrop-filter: blur(18px) saturate(120%);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }

  .site-nav__inner {
    width: var(--nav-shell);
    min-height: 4.75rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .site-nav__brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1.15;
  }

  .site-nav__wordmark {
    color: var(--nav-ink);
    font-size: 1.65rem;
    font-weight: 450;
    letter-spacing: -0.065em;
  }

  .site-nav__wordmark b {
    color: #1d3557;
    font-weight: 700;
    letter-spacing: 0;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .site-nav__links a,
  .site-nav__menu a {
    color: var(--nav-soft);
    font-size: 0.94rem;
    text-decoration: none;
  }

  .site-nav__links a:hover,
  .site-nav__menu a:hover {
    color: var(--nav-ink);
  }

  .site-nav__links a[aria-current='page'],
  .site-nav__menu a[aria-current='page'] {
    color: var(--ml-system, #1b4f72);
    font-weight: 500;
  }

  .site-nav__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.62rem 1.05rem;
    border-radius: 0.3rem;
    color: #fff;
    background: #1d3557;
    font-size: 0.86rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease;
  }

  .site-nav__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(29, 53, 87, 0.2);
  }

  .site-nav__menu {
    display: none;
    position: relative;
  }

  .site-nav__menu summary {
    color: var(--nav-ink);
    font-size: 0.85rem;
    cursor: pointer;
    list-style: none;
  }

  .site-nav__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__menu > div {
    position: absolute;
    top: 2.2rem;
    right: 0;
    min-width: 13rem;
    display: grid;
    padding: 0.7rem;
    background: var(--ml-paper-raised, #faf7f1);
    border: 1px solid var(--nav-line);
    box-shadow: 0 18px 50px rgba(32, 30, 25, 0.12);
  }

  .site-nav__menu a {
    padding: 0.7rem 0.8rem;
  }

  @media (max-width: 980px) {
    .site-nav__inner {
      grid-template-columns: 1fr auto;
      width: min(100% - 2rem, 60rem);
    }

    .site-nav__links {
      display: none;
    }

    .site-nav__menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .site-nav__cta {
      display: none;
    }
  }
</style>
