{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "michaeljlow.com" }],
      "destination": "https://www.workwithlayer.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.michaeljlow.com" }],
      "destination": "https://www.workwithlayer.com/:path*",
      "permanent": true
    },
    {
